#!/bin/bash
# updatecache - re-render the prerender snapshot for one or more pages
# Usage: ./updatecache --sync-keys                 rebuild the valid-key index (after data changes)
#        ./updatecache --status                    cached / uncached / total counts for every page type
#        ./updatecache --inspect promoter some-key why does the gatekeeper see / not see this page? (JSON, worker key index,
#                                                  exact and look-alike KV keys, fresh/stale/missing verdict)
#        ./updatecache --staleness                 how fresh/stale the stored snapshots are, against the gatekeeper's policy
#        ./updatecache --list-stale [N]            the N stalest pages (default 20) as URLs, oldest first; refresh them with
#                                                  ./updatecache $(./updatecache --list-stale 20)
#        ./updatecache --list-performers           list performers that have no snapshot yet (count at the end)
#        ./updatecache --list-venues               same, for venues
#        ./updatecache --list-storyclubs           same, for story clubs
#        ./updatecache --list-festivals            same, for festival.html?festival=
#        ./updatecache --list-promoters            same, for promoters.html?promoter=
#        ./updatecache --list-booksmerch           same, for books_merch.html?performer=
#        ./updatecache --list-events               same, for event.html?event=<eventId>  (render with --event [N] / --event <id>)
#        ./updatecache --list-repertoire           same, for tour_guide.html?performer=<p>&tour=rep:<show>
#                                                  (render with --festival / --promoter / --booksmerch / --repertoire [N];
#                                                  for repertoire a key is the show id, e.g. --repertoire debs-newbold-dauntless)
#        ./updatecache --performer [N]             render N (default 1) uncached performers
#        ./updatecache --venue [N]                 render N (default 1) uncached venues
#        ./updatecache --storyclub [N]             render N (default 1) uncached story clubs
#                                                  one KV lookup, then N renders NT_DELAY seconds
#                                                  apart (default 12); stops if the daily quota runs out
#        ./updatecache --performer tis-tales       render just that key (works for every type above;
#                                                  several keys allowed; always re-renders, no KV
#                                                  lookup; spaces ok: --performer 'Jane Doe').
#                                                  Keys not in the events JSON are skipped, not
#                                                  rendered (NT_NO_CHECK=1 disables the check).
#                                                  Plural forms work too: --festivals 5
#        ./updatecache mypage.html                 refresh NOW (default)
#        ./updatecache 'performers.html?performer=abc'
#        ./updatecache https://newtroubadours.org/venues?venue=xyz
#
#   --list-performers    print every performer key that has no snapshot yet (one
#                        per line, URI-encoded as stored in KV), then a count on
#                        stderr. Renders nothing. Uses one KV list call (or a few
#                        if the store is large), no browser time.
#   --performer | --venue | --storyclub
#                        render ONE random page of that type that has no snapshot
#                        yet (lists the KV store, diffs it against the keys in
#                        events_normalized.json, renders one missing page).
#                        Needs jq, shuf and `npx wrangler login`. Set
#                        NT_KEYS_JQ_PERFORMER / _VENUE / _STORYCLUB to the jq
#                        filter that lists that type's keys in the JSON.
#   --stale <pages>      mark page(s) stale: keeps serving the old snapshot, uses
#                        NO browser time; the next prewarm run / render-tier bot
#                        request refreshes it (bot refreshes are rate-limited to
#                        about one per minute). Good for bulk edits or when the
#                        daily quota is gone.
#   --soft-purge-all     mark EVERY snapshot stale, delete nothing
#   --purge-only <pages> delete the snapshot(s): use for a bad render or a
#                        page that no longer exists
#   --purge <pages>      delete, then refresh now (risky if quota is out)
#   --hard-purge-all     treat EVERY snapshot as missing (asks for confirmation).
#                        Bots get the plain origin page until pages are re-rendered.
#
# Default behaviour only force-renders. A successful render overwrites the stored
# snapshot. A failed one (rate limit / daily quota) keeps the old snapshot AND
# marks it stale (you'll see x-marked-stale: true), so the next prewarm run or
# bot request retries it automatically.
#
# Requires: export NT_DEBUG_SECRET=your-DEBUG_SECRET-value

HOST="newtroubadours.org"
SECRET="${NT_DEBUG_SECRET:?Set NT_DEBUG_SECRET first to the DEBUG_SECRET of the worker}"

if [ "$1" = "--soft-purge-all" ]; then
  curl -s -w "  [HTTP %{http_code}]\n" -H "x-soft-purge: $SECRET" "https://$HOST/"
  exit 0
fi

if [ "$1" = "--hard-purge-all" ]; then
  echo "This makes EVERY snapshot count as missing. On the free plan it can take"
  echo "weeks to re-render them all. Consider --soft-purge-all instead."
  read -r -p "Type YES to continue: " answer
  [ "$answer" = "YES" ] || { echo "Cancelled."; exit 1; }
  curl -s -w "  [HTTP %{http_code}]\n" -H "x-hard-purge-all: $SECRET" "https://$HOST/"
  exit 0
fi

# --sync-keys: rebuild the valid-key index (meta:keys) the gatekeeper uses to
# skip renders for pages that don't exist. Run after events_normalized.json changes.
if [ "$1" = "--sync-keys" ]; then
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  index=""
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    index=$(curl -sf --max-time 60 "$json_url" | jq -c '{
      performers: (.performers | keys),
      venues: (.venues | keys),
      promoters: (.promoters | keys),
      festivals: (.festivals | keys),
      tours: ((.tours | keys) + ((.repertoire_shows // {}) | keys | map("rep:" + .))),
      clubs: ([.clubs[].club?] + [.. | objects | .club? | strings]
              | map(select(. != "" and . != "other")) | unique)
    }' 2>/dev/null) && [ -n "$index" ] && break
    index=""
  done
  [ -n "$index" ] || { echo "Could not build the key index (set NT_EVENTS_JSON?)" >&2; exit 1; }
  curl -s -w "  [HTTP %{http_code}]\n" -X POST -H "x-sync-keys: $SECRET" \
    --data "$index" "https://$HOST/"
  exit 0
fi

# Progress line on stderr, only when stderr is a terminal (so pipes and $(...) stay clean).
note() { if [ -t 2 ]; then echo "$*" >&2; fi; }

# Run a command with a time limit (no GNU timeout needed, so it works on macOS). Its stdin is
# /dev/null, so npx/wrangler can never sit waiting for an answer to a prompt. Returns the
# command's status, or 128+ if it was killed for taking longer than SECS seconds.
#   run_with_timeout <secs> <command> [args...]
run_with_timeout() {
  local secs="$1" pid wd rc
  shift
  "$@" </dev/null &
  pid=$!
  ( sleep "$secs"; pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  wd=$!
  wait "$pid" 2>/dev/null
  rc=$?
  { kill "$wd"; wait "$wd"; } 2>/dev/null
  return $rc
}

# List the KV keys under a prefix and print them as a JSON array. wrangler can fail on its
# first call (expired login token being refreshed, npx install notice, a transient network
# error) or print noise before the JSON, so: start parsing at the first line that begins the
# JSON array, require a valid array, and retry. Each attempt is time-limited (NT_KV_TIMEOUT,
# default 60s) and wrangler's own messages stay visible on your terminal. If every attempt
# fails, stop instead of carrying on with an empty "cached" set (which would make every page
# look uncached and waste renders on pages that already have snapshots).
#   kv_list_json <prefix>
kv_list_json() {
  local prefix="$1" attempt out outfile rc secs="${NT_KV_TIMEOUT:-60}"
  outfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-kv-out.XXXXXX")
  note "Listing KV snapshots with wrangler (each attempt gives up after ${secs}s)..."
  for attempt in 1 2 3; do
    run_with_timeout "$secs" npx wrangler kv key list --namespace-id "$NT_KV_NAMESPACE_ID" --remote \
      --prefix "$prefix" >"$outfile"
    rc=$?
    # Keep only the JSON array: from the first line starting with "[" to its end
    # (a one-line "[...]", or a pretty-printed array closed by a line starting "]").
    out=$(awk '/^\[/ { s = 1 } s { print } s && (/^\]/ || /^\[.*\]$/) { exit }' "$outfile")
    if [ -n "$out" ] && printf '%s' "$out" | jq -e 'type == "array"' >/dev/null 2>&1; then
      rm -f "$outfile"
      printf '%s\n' "$out"
      return 0
    fi
    if [ "$rc" -ge 128 ]; then
      echo "wrangler did not answer within ${secs}s (attempt $attempt of 3)." >&2
    elif [ $attempt -lt 3 ]; then
      echo "KV lookup failed (attempt $attempt of 3); retrying..." >&2
    fi
    [ $attempt -lt 3 ] && sleep 3
  done
  echo "KV lookup failed after 3 attempts; stopping so nothing is rendered by mistake." >&2
  if [ -s "$outfile" ]; then echo "--- wrangler stdout (first 10 lines):" >&2; head -n 10 "$outfile" >&2; fi
  rm -f "$outfile"
  echo "If wrangler printed nothing above, run it by hand to see what it wants:" >&2
  echo "  npx wrangler kv key list --namespace-id $NT_KV_NAMESPACE_ID --remote | head" >&2
  echo "(npx wrangler whoami, or npx wrangler login, if it is an authentication problem)" >&2
  return 1
}

# Event ids carry their date as YYYYMMDD (e.g. R-some-show-20261112-some-venue). Reads ids on
# stdin and prints "YYYYMMDD<TAB>id" for those dated today or later (the upcoming ones).
upcoming_dated() {
  local today
  today=$(date +%Y%m%d)
  awk -v t="$today" 'match($0, /(^|-)(19|20)[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(-|$)/) {
    s = substr($0, RSTART, RLENGTH); gsub(/-/, "", s); if (s >= t) printf "%s\t%s\n", s, $0 }'
}

# Force-render one URL and print the status headers. Returns 1 if the daily
# browser quota is exhausted (so callers can stop).
#   render_one <url> <n>
render_one() {
  local url="$1" n="$2" result
  echo "[$n] === $url"
  result=$(curl -s --max-time 120 -o /dev/null -D - -H "x-force-render: $SECRET" "$url" \
    | grep -iE '^(HTTP/|x-prerendered|x-quota-exhausted|x-marked-stale)' | tr -d '\r' | paste -sd' ' -)
  echo "$result"
  case "$result" in
    *x-quota-exhausted*) echo "Daily browser quota exhausted; stopping." >&2; return 1 ;;
  esac
  return 0
}

# Render ONE random page of a given type that has no snapshot yet.
# With LIST_ONLY=1 it instead prints every uncached key and exits.
# With explicit keys (KEYS_GIVEN) it renders just those, with no KV lookup.
#   fill_one <page> <param> <default-jq> <jq-env-override>
fill_one() {
  local page="$1" param="$2" default_jq="$3" jq_override="$4"
  # Optional: rawmode=1 means the jq filter outputs complete, already-encoded
  # query tails ("performer-id&tour=rep%3Ashow-id") instead of single keys, and
  # tag is a fixed string that picks this type's snapshots out of the shared page
  # (used for repertoire pages, which live on tour_guide.html next to real tours).
  local rawmode="${5:-0}" tag="${6:-}"
  # prefer_upcoming=1 (events): uncached ids whose date is today or later come first.
  local prefer_upcoming="${7:-0}"
  local what="$param"; [ "$rawmode" = "1" ] && what="repertoire"

  # Explicit keys given (e.g. ./updatecache --performer tis-tales): render just
  # those, after checking each is a real key in the events JSON (unknown keys
  # are skipped and no render is spent). Re-renders even if a snapshot exists.
  if [ "${LIST_ONLY:-0}" != "1" ] && [ ${#KEYS_GIVEN[@]} -gt 0 ]; then
    command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
    local k raw enc valid="" n=0 skipped=0 vname vurl ok hint
    if [ "${NT_NO_CHECK:-0}" != "1" ] || [ "$rawmode" = "1" ]; then
      for vname in events_normalized events_normalised; do
        vurl="${NT_EVENTS_JSON:-https://$HOST/$vname.json}"
        valid=$(curl -sf --max-time 60 "$vurl" | jq -r "${!jq_override:-$default_jq}" 2>/dev/null)
        [ -n "$valid" ] && break
      done
      [ -n "$valid" ] || { echo "Could not load the valid $param keys; nothing rendered. (NT_NO_CHECK=1 skips the check.)" >&2; exit 1; }
    fi
    for k in "${KEYS_GIVEN[@]}"; do
      # Compare the decoded key: a key containing % is treated as URL-encoded.
      if [[ "$k" == *%* ]]; then raw=$(printf '%b' "${k//%/\\x}"); else raw="$k"; fi
      ok=1; enc=""
      if [ "$rawmode" = "1" ]; then
        # Composite keys: the key given is the show id (a leading "rep:" is
        # fine); find its full "performer&tour=..." query in the valid list.
        raw="${raw#rep:}"
        enc=$(printf '%s\n' "$valid" | awk -v s="${tag}$(jq -rn --arg k "$raw" '$k|@uri')" \
          'length($0) >= length(s) && substr($0, length($0) - length(s) + 1) == s { print; exit }')
        [ -n "$enc" ] || ok=0
      elif [ "${NT_NO_CHECK:-0}" != "1" ] && ! printf '%s\n' "$valid" | grep -Fxq -- "$raw"; then
        ok=0
      fi
      if [ $ok -eq 0 ]; then
        hint=" (NT_NO_CHECK=1 to render anyway)"; [ "$rawmode" = "1" ] && hint=""
        echo "Skipping '$k': not a known key for $page.html$hint." >&2
        skipped=$((skipped + 1))
        continue
      fi
      [ $n -gt 0 ] && sleep "$DELAY"
      n=$((n + 1))
      # Raw keys are URL-encoded here ("Jane Doe" -> Jane%20Doe); a key that
      # already contains a % is assumed to be encoded and used as given.
      if [ "$rawmode" != "1" ]; then
        if [[ "$k" == *%* ]]; then enc="$k"; else enc=$(jq -rn --arg k "$k" '$k|@uri'); fi
      fi
      render_one "https://$HOST/$page.html?$param=$enc" "$n" || break
    done
    [ $skipped -gt 0 ] && echo "$skipped key(s) skipped as invalid." >&2
    exit 0
  fi

  # Paste the 32-char id from `npx wrangler kv namespace list`
  # (title: newtroubadours-render-cache). Can be overridden via the environment.
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  [ "$NT_KV_NAMESPACE_ID" != "PASTE_NAMESPACE_ID_HERE" ] || {
    echo "Edit updatecache and set NT_KV_NAMESPACE_ID (npx wrangler kv namespace list)" >&2; exit 1; }

  # jq filter that outputs one key per line. ADJUST to your JSON shape.
  local jq_keys="${!jq_override:-$default_jq}"
  local prefix="render:https://$HOST/$page.html?$param="
  local uri_filter="| @uri"; [ "$rawmode" = "1" ] && uri_filter=""
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

  local all cached key name json_url
  note "Fetching the events JSON..."
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    # The worker builds its KV keys with URLSearchParams, which encodes a space as
    # "+", leaves "*" alone and encodes "~" as %7E (jq's @uri does the opposite).
    # Convert so these keys match the stored KV key names exactly.
    all=$(curl -sf --max-time 60 "$json_url" | jq -r "$jq_keys $uri_filter" 2>/dev/null \
      | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g' | sort -u)
    [ -n "$all" ] && break
  done
  [ -n "$all" ] || { echo "No $param keys found; set $jq_override to the right jq filter" >&2; exit 1; }

  local kvjson
  read_epochs
  kvjson=$(kv_list_json "$prefix") || exit 1
  # Snapshots older than the last hard purge are treated as missing by the
  # gatekeeper, so they count as uncached here too.
  cached=$(printf '%s\n' "$kvjson" \
    | jq -r --arg p "$prefix" --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name | ltrimstr($p)' \
    | { if [ -n "$tag" ]; then grep -F -- "$tag"; else cat; fi; } | sort -u)

  local missing up_dated up_ids rest_ids nup=0 upnote=""
  missing=$(comm -23 <(echo "$all") <(echo "$cached"))
  if [ -n "$missing" ] && [ "$prefer_upcoming" = "1" ]; then
    up_dated=$(printf '%s\n' "$missing" | upcoming_dated)
    nup=$(printf '%s' "$up_dated" | grep -c .)
    up_ids=$(printf '%s' "$up_dated" | cut -f2-)
    if [ "$nup" -gt 0 ]; then
      rest_ids=$(comm -23 <(printf '%s\n' "$missing" | sort) <(printf '%s\n' "$up_ids" | sort))
    else
      rest_ids="$missing"
    fi
    upnote=" ($nup upcoming)"
  fi

  if [ "${LIST_ONLY:-0}" = "1" ]; then
    if [ -n "$missing" ]; then
      if [ "$prefer_upcoming" = "1" ]; then
        # Upcoming first, soonest first, then the rest.
        { [ "$nup" -gt 0 ] && printf '%s\n' "$up_dated" | sort | cut -f2-
          [ -n "$rest_ids" ] && printf '%s\n' "$rest_ids"; }
      else
        echo "$missing"
      fi
      echo "$(echo "$missing" | wc -l | tr -d ' ') of $(echo "$all" | wc -l | tr -d ' ') $what pages have no snapshot$upnote." >&2
    else
      echo "All $what pages already have snapshots." >&2
    fi
    exit 0
  fi

  # One KV lookup above; now render up to COUNT random uncached pages from it,
  # spaced DELAY seconds apart (free-plan Browser Run allows ~1 render per 10s).
  # For events, random upcoming ones first, then random others.
  local keys total result i=0
  [ -n "$missing" ] || { echo "All $what pages already have snapshots."; exit 0; }
  total=$(echo "$missing" | wc -l | tr -d ' ')
  if [ "$prefer_upcoming" = "1" ]; then
    keys=$({ [ "$nup" -gt 0 ] && printf '%s\n' "$up_ids" | shuf
             [ -n "$rest_ids" ] && printf '%s\n' "$rest_ids" | shuf; } | head -n "$COUNT")
    echo "$total $what pages have no snapshot$upnote; rendering up to $COUNT, upcoming first (one every ${DELAY}s)."
  else
    keys=$(echo "$missing" | shuf -n "$COUNT")
    echo "$total $what pages have no snapshot; rendering up to $COUNT (one every ${DELAY}s)."
  fi

  while IFS= read -r key; do
    [ $i -gt 0 ] && sleep "$DELAY"
    i=$((i + 1))
    key="${key//+/%20}"   # back to %20 for the request URL (a literal + is already %2B)
    render_one "https://$HOST/$page.html?$param=$key" "$i" || break
  done <<< "$keys"
  exit 0
}

# jq filters that list each page type's keys in events_normalized.json
# (each can be overridden with NT_KEYS_JQ_<TYPE>, e.g. NT_KEYS_JQ_BOOKSMERCH).
JQ_PERFORMER='.performers | keys[]'
JQ_VENUE='.venues | keys[]'
JQ_STORYCLUB='[.clubs[].club] | unique | .[]'
JQ_FESTIVAL='.festivals | keys[]'
JQ_PROMOTER='.promoters | keys[]'
JQ_BOOKSMERCH='.performers | to_entries[] | select(((.value.books // []) | length) > 0 or ((.value.merch // []) | length) > 0) | .key'
# Event pages are event.html?event=<eventId>. Every "eventId" string anywhere in the JSON
# counts (regular events and repertoire show_dates alike), so this doesn't depend on where
# events live. If your ids sit under another field name, set NT_KEYS_JQ_EVENT.
JQ_EVENT='[.. | objects | .eventId? | strings | select(. != "")] | unique | .[]'
# Repertoire pages are tour_guide.html?performer=<performer>&tour=rep:<show>. Each key in
# .repertoire_shows is a show id; its performer is the longest performer id that is a
# prefix of it (e.g. debs-newbold-dauntless -> debs-newbold). Shows with no matching
# performer are left out. The output is the complete, already-encoded query tail.
JQ_REPERTOIRE='(.performers | keys) as $p | (.repertoire_shows // {} | keys[]) as $k | ([$p[] | . as $x | select($k | startswith($x + "-"))] | sort_by(length) | last) as $perf | select($perf != null) | "\($perf | @uri)&tour=\("rep:" + $k | @uri)"'

# --status: cached / uncached counts for every page type. One download of the
# events JSON and ONE KV listing; no renders, no browser time.
#   status_row <label> <page> <param> <default-jq> <jq-env-override>
status_row() {
  local label="$1" page="$2" param="$3" default_jq="$4" jq_override="$5"
  local rawmode="${6:-0}" tag="${7:-}" uri_filter="| @uri"; [ "$rawmode" = "1" ] && uri_filter=""
  local jq_keys="${!jq_override:-$default_jq}"
  local prefix="render:https://$HOST/$page.html?$param="
  local all cached nall ncached nextra
  all=$(echo "$STATUS_JSON" | jq -r "$jq_keys $uri_filter" 2>/dev/null \
    | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g' | sort -u)
  cached=$(echo "$STATUS_NAMES" \
    | awk -v p="$prefix" 'index($0, p) == 1 { print substr($0, length(p) + 1) }' \
    | { if [ -n "$tag" ]; then grep -F -- "$tag"; else cat; fi; } | sort -u)
  nall=$(echo "$all" | grep -c .)
  ncached=$(comm -12 <(echo "$all") <(echo "$cached") | grep -c .)
  nextra=$(comm -13 <(echo "$all") <(echo "$cached") | grep -c .)
  printf '%-12s %7s %9s %7s %7s\n' "$label" "$ncached" "$((nall - ncached))" "$nall" "$nextra"
}

status_all() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local name json_url
  STATUS_JSON=""
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    STATUS_JSON=$(curl -sf --max-time 60 "$json_url") && [ -n "$STATUS_JSON" ] && break
    STATUS_JSON=""
  done
  [ -n "$STATUS_JSON" ] || { echo "Could not fetch the events JSON (set NT_EVENTS_JSON?)" >&2; exit 1; }
  local statusjson
  read_epochs
  statusjson=$(kv_list_json "render:https://$HOST/") || exit 1
  STATUS_NAMES=$(printf '%s\n' "$statusjson" \
    | jq -r --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name')
  printf '%-12s %7s %9s %7s %7s\n' type cached uncached total orphans
  status_row performers  performers  performer "$JQ_PERFORMER"   NT_KEYS_JQ_PERFORMER
  status_row venues      venues      venue     "$JQ_VENUE"       NT_KEYS_JQ_VENUE
  status_row storyclubs  storyclub   club      "$JQ_STORYCLUB"   NT_KEYS_JQ_STORYCLUB
  status_row festivals   festival    festival  "$JQ_FESTIVAL"    NT_KEYS_JQ_FESTIVAL
  status_row promoters   promoters   promoter  "$JQ_PROMOTER"    NT_KEYS_JQ_PROMOTER
  status_row booksmerch  books_merch performer "$JQ_BOOKSMERCH"  NT_KEYS_JQ_BOOKSMERCH
  status_row repertoire  tour_guide  performer "$JQ_REPERTOIRE"  NT_KEYS_JQ_REPERTOIRE 1 "&tour=rep%3A"
  status_row events      event       event     "$JQ_EVENT"       NT_KEYS_JQ_EVENT
  echo "(orphans = snapshots whose key is no longer in the JSON; 'cached' counts any stored snapshot, stale or not,"
  echo " but not ones older than the last hard purge, which the gatekeeper treats as missing; see --staleness)" >&2
  exit 0
}

# ── staleness report ────────────────────────────────────────────────────────
# Mirrors the gatekeeper's policy (gatekeeper.js): a snapshot is STALE when its ts is
# older than FRESH_SECONDS (48h) or older than the soft-purge epoch, and counts as
# MISSING when its ts is older than the hard-purge epoch (both live in the KV key
# meta:epochs). The gatekeeper stores ts as KV metadata and sets a KV expiry on every
# write, so ONE key listing gives every page's age and expiry with no per-key reads.
FRESH_HOURS="${NT_FRESH_HOURS:-48}"            # gatekeeper FRESH_SECONDS, in hours
TTL_DAYS="${NT_TTL_DAYS:-14}"                  # gatekeeper KV_TTL_SECONDS, in days
TTL_MS=$(( TTL_DAYS * 86400000 ))
EXPIRY_WARN_HOURS="${NT_EXPIRY_WARN_HOURS:-48}"
# A snapshot's age: the ts the gatekeeper stored as KV metadata or, when the key listing has
# no metadata (snapshots written before the gatekeeper stored it), the write time implied by
# the KV expiry: every write sets expirationTtl = KV_TTL_SECONDS, so written = expiry - TTL.
# entry_est is true when the age had to be derived from the expiry. Needs --argjson ttl.
JQ_TS_DEF='def entry_ts: (.metadata.ts // (if .expiration != null then (.expiration * 1000 - $ttl) else null end));
  def entry_est: ((.metadata.ts == null) and (.expiration != null));
  '
EPOCH_SOFT=0; EPOCH_HARD=0; EPOCH_NOTE=""; EPOCHS_READ=""

# Read the purge epochs ({"soft":ms,"hard":ms}; 0 = never purged). One KV read per run.
read_epochs() {
  [ -n "$EPOCHS_READ" ] && return 0
  EPOCHS_READ=1
  command -v jq >/dev/null || return 0
  local out
  note "Reading the purge epochs..."
  out=$(run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get meta:epochs \
          --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null \
        | awk '/^\{/ { s = 1 } s { print } s && /\}$/ { exit }')
  if [ -n "$out" ] && printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1; then
    EPOCH_SOFT=$(printf '%s' "$out" | jq -r '(.soft // 0) | floor')
    EPOCH_HARD=$(printf '%s' "$out" | jq -r '(.hard // 0) | floor')
  else
    EPOCH_NOTE="no meta:epochs found (never purged), or it could not be read"
  fi
}

fmt_epoch() {
  if [ "$1" -gt 0 ] 2>/dev/null; then
    jq -rn --argjson ms "$1" '$ms / 1000 | floor | strftime("%Y-%m-%d %H:%M UTC")'
  else
    echo "never"
  fi
}

# One row per page type, same classification as the gatekeeper:
#   invalid = ts older than the hard purge (served as missing)
#   stale   = ts older than the soft purge or older than the fresh window
#   fresh   = everything else
#   est     = age estimated from the KV expiry (the listing has no ts metadata)
#   unk     = neither ts metadata nor an expiry, so no age at all
JQ_STALE_ROWS='
  def kind:
    (.name | ltrimstr($base)) as $r
    | ($r | split("?")[0]) as $path
    | if $path == "/tour_guide.html" and ($r | test("tour=rep%3A")) then $path + " (rep)" else $path end;
  [ .[] | select(.name | startswith($base))
        | { kind: kind, ts: entry_ts, est: entry_est, exp: (.expiration // null) } ]
  | group_by(.kind)[]
  | . as $g
  | [ $g[0].kind,
      ($g | length),
      ([ $g[] | select(.ts != null and .ts >= $hard and .ts >= $soft and ($now - .ts) <= $fresh) ] | length),
      ([ $g[] | select(.ts != null and .ts >= $hard and (.ts < $soft or ($now - .ts) > $fresh)) ] | length),
      ([ $g[] | select(.ts != null and .ts < $hard) ] | length),
      ([ $g[] | select(.est) ] | length),
      ([ $g[] | select(.ts == null) ] | length),
      ([ $g[] | select(.ts != null and .ts > 0 and .ts >= $hard) | ($now - .ts) ] | max // -1),
      ([ $g[] | select(.exp != null and (.exp * 1000 - $now) < $soon) ] | length)
    ] | @tsv'

# marked-stale (ts=0), soft-purged, aged-out, hard-purged, expiring soon, total stored, age estimated
JQ_STALE_BREAKDOWN='
  [ .[] | select(.name | startswith($base)) | entry_ts | select(. != null) ] as $t
  | [ ([ $t[] | select(. == 0 and . >= $hard) ] | length),
      ([ $t[] | select(. > 0 and . >= $hard and . < $soft) ] | length),
      ([ $t[] | select(. > 0 and . >= $hard and . >= $soft and ($now - .) > $fresh) ] | length),
      ([ $t[] | select(. < $hard) ] | length),
      ([ .[] | select(.name | startswith($base)) | select(.expiration != null and (.expiration * 1000 - $now) < $soon) ] | length),
      ([ .[] | select(.name | startswith($base)) ] | length),
      ([ .[] | select(.name | startswith($base)) | select(entry_est) ] | length)
    ] | @tsv'

staleness_report() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  local now_ms=$(( $(date +%s) * 1000 ))
  local fresh_ms=$(( FRESH_HOURS * 3600000 )) soon_ms=$(( EXPIRY_WARN_HOURS * 3600000 ))
  local json rows marked softp aged invalid expiring stored est stale
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  local args=(--arg base "render:https://$HOST" --argjson now "$now_ms" --argjson fresh "$fresh_ms"
              --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD" --argjson soon "$soon_ms"
              --argjson ttl "$TTL_MS")
  rows=$(printf '%s\n' "$json" | jq -r "${args[@]}" "$JQ_TS_DEF $JQ_STALE_ROWS")
  [ -n "$rows" ] || { echo "No snapshots are stored under render:https://$HOST/"; exit 0; }
  read -r marked softp aged invalid expiring stored est \
    <<< "$(printf '%s\n' "$json" | jq -r "${args[@]}" "$JQ_TS_DEF $JQ_STALE_BREAKDOWN")"
  stale=$(( marked + softp + aged ))

  echo "Gatekeeper policy (from gatekeeper.js; set NT_FRESH_HOURS / NT_TTL_DAYS if you change the constants):"
  printf '  %-13s %s\n' "fresh window" "${FRESH_HOURS}h: older snapshots are still served, flagged stale"
  printf '  %-13s %s\n' "KV expiry" "${TTL_DAYS}d after the last write: then the page counts as uncached"
  printf '  %-13s %s\n' "soft purge" "$(fmt_epoch "$EPOCH_SOFT"): snapshots older than this count as stale"
  printf '  %-13s %s\n' "hard purge" "$(fmt_epoch "$EPOCH_HARD"): snapshots older than this count as missing"
  [ -n "$EPOCH_NOTE" ] && echo "  ($EPOCH_NOTE)"
  echo
  printf '%s\n' "$rows" | awk -F'\t' -v warn="$EXPIRY_WARN_HOURS" '
    function age(ms) { if (ms < 0) return "-"; if (ms >= 86400000) return sprintf("%.1fd", ms / 86400000); return sprintf("%.1fh", ms / 3600000) }
    BEGIN { mx = -1; printf "%-24s %6s %6s %6s %7s %5s %4s %7s %8s\n", "page", "stored", "fresh", "stale", "invalid", "est", "unk", "oldest", "exp<" warn "h" }
    NF { printf "%-24s %6d %6d %6d %7d %5d %4d %7s %8d\n", $1, $2, $3, $4, $5, $6, $7, age($8), $9
         for (i = 2; i <= 7; i++) t[i] += $i; t[9] += $9; if ($8 + 0 > mx) mx = $8 + 0 }
    END { printf "%-24s %6d %6d %6d %7d %5d %4d %7s %8d\n", "TOTAL", t[2], t[3], t[4], t[5], t[6], t[7], age(mx), t[9] }'
  echo "(est = age estimated from the KV expiry; unk = no age available; oldest ignores marked-stale pages)"
  echo
  echo "Stale: $stale of $stored  (aged past ${FRESH_HOURS}h: $aged, soft-purged: $softp, marked stale with ts=0: $marked)"
  if [ "$est" -gt 0 ]; then
    echo "Ages: $est of $stored are estimated from the KV expiry (written = expiry - ${TTL_DAYS}d) because the key"
    echo "  listing has no ts metadata for them. That is accurate for pages the gatekeeper wrote, but a page marked"
    echo "  stale (ts=0) can only be spotted where its metadata is present."
  fi
  echo "Invalid (hard-purged, served as missing): $invalid.   Expiring within ${EXPIRY_WARN_HOURS}h: $expiring"
  awk -v n="$(( stale + invalid ))" 'BEGIN { printf "Refreshing all %d stale/invalid pages = about %d x 2s = %.1f min of browser time (free plan: 10 min/day, shared with crawlers).\n", n, n, n * 2 / 60 }'
  echo
  echo "How the gatekeeper treats them:"
  echo "  - Stale snapshots are still served to bots (x-prerender-stale: true); nothing is lost while they wait."
  echo "  - A stale page is refreshed only when a render-tier bot (Bing, DuckDuckGo, Apple, social-preview bots)"
  echo "    requests that exact page, its key is in the meta:keys index, and it wins the one-per-minute render"
  echo "    slot; or when you (or a prewarm) force-render it. Googlebot, Yandex, Baidu and Yahoo never trigger one."
  echo "  - Invalid pages are treated as missing: bots get the plain origin page until the page is re-rendered."
  echo "  - Marking a page stale (--stale, or a failed forced render) sets ts=0 but restarts its ${TTL_DAYS}d KV expiry."
  echo "  - List the worst offenders with: ./updatecache --list-stale 20"
  exit 0
}

# --list-stale [N]: the N stalest pages (default 20), oldest first, as full URLs.
# "Stale" = needs a refresh: stale by the gatekeeper's policy, or hard-purged. Feed the
# list straight back in:  ./updatecache $(./updatecache --list-stale 20)
list_stale() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local n=20
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && n="$1"
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  local now_ms=$(( $(date +%s) * 1000 )) fresh_ms=$(( FRESH_HOURS * 3600000 )) json all
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  all=$(printf '%s\n' "$json" | jq -r --arg base "render:https://$HOST" --argjson now "$now_ms" \
      --argjson fresh "$fresh_ms" --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD" \
      --argjson ttl "$TTL_MS" "$JQ_TS_DEF"'
      [ .[] | select(.name | startswith($base)) | { name: .name, ts: entry_ts }
            | select(.ts != null)
            | select(.ts < $hard or .ts < $soft or ($now - .ts) > $fresh) ]
      | sort_by(.ts) | .[] | .name | ltrimstr("render:")')
  [ -n "$all" ] || { echo "No stale snapshots." >&2; exit 0; }
  echo "$(printf '%s\n' "$all" | wc -l | tr -d ' ') snapshot(s) need a refresh; listing the oldest $n." >&2
  printf '%s\n' "$all" | head -n "$n"
  exit 0
}

# --inspect <type> <key>: why does the gatekeeper see (or not see) this page? Checks, in order:
# 1. is the key in the events JSON (what --list-*, --status and the render options use),
# 2. is it in the worker's meta:keys index (what lets crawlers trigger a render),
# 3. which snapshots exist in KV for it, including look-alike keys (other host, path or letter
#    case) that the gatekeeper would never read, because it looks up one exact key.
inspect_key() {
  local page="$1" param="$2" index_name="$3" default_jq="$4" jq_override="$5" key="$6" cmd="$7"
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local jq_keys="${!jq_override:-$default_jq}" raw="$key" enc expected name vurl valid="" near idx
  local json rows exact_state others needle now_ms
  [[ "$key" == *%* ]] && raw=$(printf '%b' "${key//%/\\x}")
  # The KV key the gatekeeper builds (URLSearchParams encoding: space = +, ~ = %7E).
  enc=$(jq -rn --arg k "$raw" '$k | @uri' | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g')
  expected="render:https://$HOST/$page.html?$param=$enc"
  echo "Page:   https://$HOST/$page.html?$param=$enc"
  echo "KV key: $expected"
  echo

  # 1. events JSON
  for name in events_normalized events_normalised; do
    vurl="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    valid=$(curl -sf --max-time 60 "$vurl" | jq -r "$jq_keys" 2>/dev/null)
    [ -n "$valid" ] && break
  done
  if [ -z "$valid" ]; then
    echo "1. events JSON: could not load the $param keys (set NT_EVENTS_JSON?)"
  elif printf '%s\n' "$valid" | grep -Fxq -- "$raw"; then
    echo "1. events JSON: yes, '$raw' is a known $param key"
  else
    near=$(printf '%s\n' "$valid" | grep -Fix -- "$raw" | head -n 1)
    if [ -n "$near" ]; then
      echo "1. events JSON: NO exact match, but '$near' differs only by letter case"
    else
      echo "1. events JSON: NO, '$raw' is not one of the $param keys, so $0 --status/--list-*/$cmd never look at it"
    fi
  fi

  # 2. the worker's valid-key index
  if [ -n "$index_name" ]; then
    note "Reading the worker's key index..."
    idx=$(run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get meta:keys \
            --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null \
          | awk '/^\{/ { s = 1 } s { print }')
    if ! printf '%s' "$idx" | jq -e 'type == "object"' >/dev/null 2>&1; then
      echo "2. worker key index (meta:keys): not found or unreadable, so the worker ALLOWS crawler renders of any key (run $0 --sync-keys)"
    elif ! printf '%s' "$idx" | jq -e --arg n "$index_name" 'has($n)' >/dev/null 2>&1; then
      echo "2. worker key index: has no '$index_name' list, so crawler renders of any key are allowed (run $0 --sync-keys)"
    elif printf '%s' "$idx" | jq -e --arg n "$index_name" --arg k "$raw" '.[$n] | any(. == $k)' >/dev/null 2>&1; then
      echo "2. worker key index: yes, crawlers may trigger a render of it"
    else
      echo "2. worker key index: NO, crawler requests get miss-origin-unknown-key and are never rendered (run $0 --sync-keys if it is new)"
    fi
  else
    echo "2. worker key index: the worker has no key check for this page type, so crawler renders are always allowed"
  fi

  # 3. snapshots in KV (any host, path or letter case)
  read_epochs
  now_ms=$(( $(date +%s) * 1000 ))
  json=$(kv_list_json "render:") || exit 1
  needle=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
  rows=$(printf '%s\n' "$json" | jq -r --arg n "$needle" --arg exp "$expected" --argjson now "$now_ms" \
      --argjson ttl "$TTL_MS" --argjson fresh "$(( FRESH_HOURS * 3600000 ))" \
      --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD" "$JQ_TS_DEF"'
    def r1: ((. * 10 | round) / 10);
    .[]
    | select((.name | ascii_downcase) | contains($n))
    | entry_ts as $ts
    | (if $ts == null then "unknown"
       elif $ts < $hard then "invalid"
       elif ($ts < $soft or ($now - $ts) > $fresh) then "stale"
       else "fresh" end) as $state
    | [ (if .name == $exp then "EXACT" else "other" end),
        $state,
        ( (.name | ltrimstr("render:"))
          + "  |  " + (if $ts == null then "age unknown"
                       else "written " + ((($now - $ts) / 3600000) | r1 | tostring) + "h ago" + (if entry_est then " (est. from expiry)" else "" end) end)
          + "  |  " + ((.metadata.bytes // "?") | tostring) + " bytes"
          + "  |  " + (if .expiration == null then "no expiry"
                       else "expires in " + ((((.expiration * 1000) - $now) / 86400000) | r1 | tostring) + "d" end)
          + "  |  " + $state ) ]
    | @tsv')
  echo "3. snapshots in KV whose key contains '$raw' (any host, path or letter case):"
  if [ -z "$rows" ]; then
    echo "   none"
  else
    printf '%s\n' "$rows" | awk -F'\t' '{ printf "   %s%s\n", ($1 == "EXACT" ? "[exact key]  " : "[look-alike] "), $3 }'
  fi
  exact_state=$(printf '%s\n' "$rows" | awk -F'\t' '$1 == "EXACT" { print $2; exit }')
  others=$(printf '%s\n' "$rows" | awk -F'\t' '$1 == "other"' | grep -c .)
  echo
  case "$exact_state" in
    fresh)   echo "Verdict: a fresh snapshot exists under the exact key, so a bot request is a hit." ;;
    stale)   echo "Verdict: the exact key is present but stale: bots are served it, and a render-tier bot may trigger a refresh." ;;
    invalid) echo "Verdict: the exact key is present but older than the last hard purge, so the gatekeeper treats it as MISSING." ;;
    unknown) echo "Verdict: the exact key is present but its age is unknown." ;;
    *)
      if [ "$others" -gt 0 ]; then
        echo "Verdict: nothing under the exact key. The gatekeeper reads only that key, so a request that arrives with a"
        echo "different host, path or letter case misses even though a look-alike snapshot exists."
      else
        echo "Verdict: no snapshot under any key, so a bot request is a miss. Render it with: $0 $cmd '$raw'"
      fi ;;
  esac
  echo "(KV changes can take up to about a minute to show at other locations, and a recent 'not found' can be cached briefly.)"
  exit 0
}

inspect_cmd() {
  local type="${1:-}" key="${2:-}"
  if [ -z "$type" ] || [ -z "$key" ]; then
    echo "Usage: $0 --inspect <performer|venue|storyclub|festival|promoter|event|booksmerch> <key>" >&2
    exit 1
  fi
  case "$type" in
    performer|performers) inspect_key performers performer performers "$JQ_PERFORMER" NT_KEYS_JQ_PERFORMER "$key" --performer ;;
    venue|venues)         inspect_key venues venue venues "$JQ_VENUE" NT_KEYS_JQ_VENUE "$key" --venue ;;
    storyclub|storyclubs) inspect_key storyclub club clubs "$JQ_STORYCLUB" NT_KEYS_JQ_STORYCLUB "$key" --storyclub ;;
    festival|festivals)   inspect_key festival festival festivals "$JQ_FESTIVAL" NT_KEYS_JQ_FESTIVAL "$key" --festival ;;
    promoter|promoters)   inspect_key promoters promoter promoters "$JQ_PROMOTER" NT_KEYS_JQ_PROMOTER "$key" --promoter ;;
    event|events)         inspect_key event event "" "$JQ_EVENT" NT_KEYS_JQ_EVENT "$key" --event ;;
    booksmerch)           inspect_key books_merch performer "" "$JQ_BOOKSMERCH" NT_KEYS_JQ_BOOKSMERCH "$key" --booksmerch ;;
    *) echo "Unknown type '$type' (performer venue storyclub festival promoter event booksmerch)" >&2; exit 1 ;;
  esac
}

# Optional count after --performer / --venue / --storyclub: how many pages to
# render in one run (default 1). Seconds between renders: NT_DELAY (default 12).
COUNT=1
KEYS_GIVEN=()
if [[ "$2" =~ ^[0-9]+$ ]]; then
  [ "$2" -ge 1 ] && COUNT="$2"
elif [ -n "$2" ]; then
  KEYS_GIVEN=("${@:2}")   # anything non-numeric after the type option = explicit key(s)
fi
DELAY="${NT_DELAY:-12}"

# Page types: fill_one <page> <url param> <default jq filter> <jq override env var>
# NOTE: booksmerch assumes performers carry "books" / "merch" fields in the JSON;
# only performers with at least one of them are listed. Override with
# NT_KEYS_JQ_BOOKSMERCH if your field names differ.
dispatch() {
  case "$1" in
    performer)  fill_one performers performer "$JQ_PERFORMER" NT_KEYS_JQ_PERFORMER ;;
    venue)      fill_one venues venue "$JQ_VENUE" NT_KEYS_JQ_VENUE ;;
    storyclub)  fill_one storyclub club "$JQ_STORYCLUB" NT_KEYS_JQ_STORYCLUB ;;
    festival)   fill_one festival festival "$JQ_FESTIVAL" NT_KEYS_JQ_FESTIVAL ;;
    promoter)   fill_one promoters promoter "$JQ_PROMOTER" NT_KEYS_JQ_PROMOTER ;;
    booksmerch) fill_one books_merch performer "$JQ_BOOKSMERCH" NT_KEYS_JQ_BOOKSMERCH ;;
    repertoire) fill_one tour_guide performer "$JQ_REPERTOIRE" NT_KEYS_JQ_REPERTOIRE 1 "&tour=rep%3A" ;;
    event)      fill_one event event "$JQ_EVENT" NT_KEYS_JQ_EVENT 0 "" 1 ;;
  esac
}

case "$1" in
  --list-performers|--list-performer)  LIST_ONLY=1; dispatch performer ;;
  --list-venues|--list-venue)          LIST_ONLY=1; dispatch venue ;;
  --list-storyclubs|--list-storyclub)  LIST_ONLY=1; dispatch storyclub ;;
  --list-festivals|--list-festival)    LIST_ONLY=1; dispatch festival ;;
  --list-promoters|--list-promoter)    LIST_ONLY=1; dispatch promoter ;;
  --list-booksmerch)                   LIST_ONLY=1; dispatch booksmerch ;;
  --list-repertoire|--list-repertoires) LIST_ONLY=1; dispatch repertoire ;;
  --list-events|--list-event)          LIST_ONLY=1; dispatch event ;;
  --status)                            status_all ;;
  --staleness)                         staleness_report ;;
  --inspect)                           inspect_cmd "${2:-}" "${3:-}" ;;
  --list-stale)                        list_stale "${2:-}" ;;
  --performer|--performers)            dispatch performer ;;
  --venue|--venues)                    dispatch venue ;;
  --storyclub|--storyclubs)            dispatch storyclub ;;
  --festival|--festivals)              dispatch festival ;;
  --promoter|--promoters)              dispatch promoter ;;
  --booksmerch)                        dispatch booksmerch ;;
  --repertoire|--repertoires)          dispatch repertoire ;;
  --event|--events)                    dispatch event ;;
  --stale|--purge|--purge-only)        ;;   # handled below
  --*) echo "Unknown option: $1 (see the usage notes at the top of this script)" >&2; exit 1 ;;
esac

STALE_ONLY=0
if [ "$1" = "--stale" ]; then STALE_ONLY=1; shift; fi

PURGE=0
PURGE_ONLY=0
case "$1" in
  --purge-only) PURGE=1; PURGE_ONLY=1; shift ;;
  --purge)      PURGE=1; shift ;;
esac

if [ $# -eq 0 ]; then
  echo "Usage: $0 [--list-<type>s | --<type> [N]]  (types: performer venue storyclub festival promoter booksmerch repertoire event) [--stale | --purge | --purge-only] <page-or-url> [...]  (or --soft-purge-all / --hard-purge-all)" >&2
  exit 1
fi

first=1
for page in "$@"; do
  if [[ "$page" == http* ]]; then
    URL="$page"
  else
    page="${page#./}"; page="${page#/}"
    URL="https://$HOST/$page"
  fi

  if [ $STALE_ONLY -eq 1 ]; then
    echo "=== $URL"
    echo -n "Mark stale: "
    curl -s -w "  [HTTP %{http_code}]\n" -H "x-mark-stale: $SECRET" "$URL"
    continue
  fi

  # Free-plan Browser Run allows ~1 render per 10s, so space pages out.
  if [ $first -eq 0 ] && [ $PURGE_ONLY -eq 0 ]; then sleep 12; fi
  first=0

  echo "=== $URL"

  if [ $PURGE -eq 1 ]; then
    echo -n "Purge:   "
    curl -s -w "  [HTTP %{http_code}]\n" \
      -H "x-purge-cache: $SECRET" "$URL"
  fi

  [ $PURGE_ONLY -eq 1 ] && continue

  # Forced render can retry 3x with ~12s gaps, so allow a long timeout
  result=$(curl -s --max-time 120 -o /dev/null \
    -D - -w "" \
    -H "x-force-render: $SECRET" "$URL" \
    | grep -iE '^(HTTP/|x-prerendered|x-quota-exhausted|x-marked-stale)' | tr -d '\r' | paste -sd' ' -)
  echo "Refresh: $result"
  case "$result" in
    *x-quota-exhausted*) echo "Daily browser quota exhausted; stopping." >&2; break ;;
  esac
done
