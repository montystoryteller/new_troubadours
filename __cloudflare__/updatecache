#!/bin/bash
# updatecache - re-render the prerender snapshot for one or more pages
# Usage: ./updatecache --delta [N] [--indexnow]    AFTER uploading a new events JSON: diff it against the worker's
#                                                  current key index (meta:keys, read before it is replaced), sync the
#                                                  index, render ONLY the new pages (N max; upcoming events first),
#                                                  and with --indexnow submit rendered pages (also from earlier runs
#                                                  that you didn't submit). Pages that didn't
#                                                  render (quota, errors) stay in ~/.updatecache-pending for next time.
#        ./updatecache --list-new                  the same delta as URLs, changing nothing (dry run)
#        ./updatecache --sync-keys                 rebuild the valid-key index only (after data changes)
#        ./updatecache --status                    cached / uncached / total counts for every page type
#        ./updatecache --count-missing             hits / misses table: every URL in https://newtroubadours.org/sitemap.xml PLUS the base
#                                                  pages (index.html, performers.html, ... the same list prewarm.yml renders first),
#                                                  per page type: how many have a snapshot in KV and how many don't
#                                                  (renders nothing, no browser time). NT_NO_BASE=1 leaves the base pages out.
#        ./updatecache --list-missing              the same table, and prints the missing URLs (one per line, request-ready)
#        ./updatecache --fill-missing [N]          force-render N (default 1) pages with no snapshot: missing base pages first,
#                                                  then RANDOM missing sitemap URLs; NT_DELAY seconds apart; stops if the daily
#                                                  quota runs out. The sitemap is built by the worker from meta:keys, so run
#                                                  --delta / --sync-keys first if the data changed. (--status compares against the
#                                                  events JSON instead; this checks exactly the URLs crawlers are told about.)
#        ./updatecache --inspect promoter some-key why does the gatekeeper see / not see this page? (JSON, worker key index,
#                                                  exact and look-alike KV keys, fresh/stale/missing verdict)
#        ./updatecache --staleness                 how fresh/stale the stored snapshots are, against the gatekeeper's policy
#        ./updatecache --list-stale [N]            the N stalest pages (default 20) as URLs, oldest first; refresh them with
#                                                  ./updatecache $(./updatecache --list-stale 20)
#        ./updatecache --refresh-stale [N] [type]  force-render N RANDOM stale pages (default 20), optionally only of one type
#                                                  (performer venue storyclub festival promoter booksmerch repertoire event),
#                                                  NT_DELAY seconds apart; stops if the daily quota runs out. Examples:
#                                                    ./updatecache --refresh-stale performer 20
#                                                    ./updatecache --refresh-stale 10          (any page type)
#                                                  "Stale" is as in --list-stale (aged out, soft-purged, marked stale, hard-purged).
#                                                  Add --all to remove the N cap, and --not-ok to ALSO include fresh snapshots whose
#                                                  health flag is not ok (or missing), or that the health log lists as unhealthy:
#                                                    ./updatecache --refresh-stale booksmerch --all --not-ok
#                                                  Pages with no health "ok" flag (error/missing/unflagged old snapshots, or in the
#                                                  gatekeeper problem log) are rendered first; NT_NO_HEALTH_PRIORITY=1 disables that.
#                                                  Add --indexnow to also submit the pages that rendered OK to IndexNow (same
#                                                  waiting list and indexnow.sh as --delta --indexnow); without it nothing is pinged.
#        ./updatecache --repair [N] [type]         re-render ONLY pages reported broken / not ok (the gatekeeper's problem log, or a
#                                                  snapshot health flag of error/warn/loading/missing/404), stale or not; not-ok
#                                                  pages are tried in random order, N max (default 20). Same options as
#                                                  --refresh-stale: a type, --all, --indexnow. Add --unflagged to also retry
#                                                  snapshots with no health flag at all (after the not-ok ones). See what it would
#                                                  pick with --health. Pages broken at the source (bad data) will just come back
#                                                  not ok after the re-render. Examples:
#                                                    ./updatecache --repair
#                                                    ./updatecache --repair venue --all
#                                                    ./updatecache --repair 50 --unflagged --indexnow
#        ./updatecache --list-recent [H]         snapshots WRITTEN in the last H hours (default 12) as URLs, newest first.
#                                                  Use after a bad deploy; save the list BEFORE purging, it vanishes once deleted:
#                                                    ./updatecache --list-recent 12 > recent.txt
#                                                    ./updatecache --purge-only $(cat recent.txt)   clear them
#                                                    ./updatecache $(cat recent.txt)                force re-render them
#        ./updatecache --list-cached [file] [type] every snapshot URL in the cache, sorted, one per line: written to
#                                                  [file] if given (else printed), optionally only one page type
#                                                  (performer venue storyclub festival promoter booksmerch repertoire event):
#                                                    ./updatecache --list-cached cached-urls.txt
#                                                    ./updatecache --list-cached venues-cached.txt venue
#                                                  Stale pages are included; ones the gatekeeper treats as missing are not (older
#                                                  than the last hard purge, which also catches marked-stale pages after one).
#        ./updatecache --health [DAYS]             renders the gatekeeper logged as NOT healthy in the last DAYS
#                                                  (default 7): error / loading / missing / warn / 404, with the reason
#                                                  (reads the health:* keys; one KV listing, no renders)
#        ./updatecache --list-expiring [H] [type]  snapshots whose KV expiry is within H hours (default 120), soonest first, as URLs:
#                                                  the pages about to drop out of the cache (a snapshot expires 90 days after its last
#                                                  write). Past events (dated >30 days ago) are left out; --all includes them. Add a
#                                                  second number to cap the list. Re-render them:  ./updatecache $(./updatecache --list-expiring 120 20)
#        ./updatecache --list-retry                pages serving an OLD snapshot because their latest render was not healthy (the
#                                                  gatekeeper keeps the old page and flags it): fails so far, age, health, reason, URL.
#                                                  "capped" ones are no longer retried first and need a data/page fix.
#        ./updatecache --list-orphans [type]       snapshots whose key is no longer in the events JSON (the orphans column of --status)
#        ./updatecache --purge-orphans [type] [--yes]  delete them (asks first; no render, no browser time)
#        ./updatecache --resolved <page>... [--yes]  remove those pages' entries from the health log (what --health and --daily
#                                                  report). Purging a snapshot or re-rendering never removes them; they only expire
#                                                  after 7 days. Pages: 50, /50, performers.html?performer=x or a full URL; exact match.
#                                                  Lists the entries and asks for YES first (--yes skips). --resolved --all clears the log.
#        ./updatecache --quota                     is the gatekeeper holding renders back after 429s? (exit status 3 = paused)
#        ./updatecache --daily [N]                 the daily routine with a budget of N renders (default 30, or NT_DAILY_RENDERS): checks the
#                                                  pause, shows last day's unhealthy renders, then spends the budget in this order, each step
#                                                  getting whatever the earlier ones left: --repair (up to N), --fill-missing, --refresh-stale
#                                                  --oldest, and LAST stale event pages dated more than 30 days ago (unhealthy ones are always repaired first, old events included). Stops cleanly when the quota
#                                                  runs out. Pages matching NT_HEALTH_IGNORE (default: event_builder.html, stats.html) are skipped.
#        ./updatecache --list-stale [N] [type]     (the type word works here too; --all lists every one)
#        --refresh-stale / --repair also take: --no-old-events (leave out event pages dated more than 30 days ago) and
#                                                  --old-events-only (just those). Without either, STALE old events are tried last; unhealthy pages always come first.
#        --refresh-stale / --repair also take: --skip-capped (leave out retry-flagged pages at the retry cap) and --skip-bad
#        ./updatecache --refresh-stale ... --oldest  render the OLDEST stale pages first instead of random ones (the not-ok and
#                                                  retry-flagged pages still come first)
#        ./updatecache --list-performers           list performers that have no snapshot yet (count at the end)
#        ./updatecache --list-venues               same, for venues
#        ./updatecache --list-storyclubs           same, for story clubs
#        ./updatecache --list-festivals            same, for festival.html?festival=
#        ./updatecache --list-promoters            same, for promoters.html?promoter=
#        ./updatecache --list-booksmerch           same, for books_merch.html?performer=
#        ./updatecache --list-events               same, for event.html?event=<eventId>  (render with --event [N] / --event <id>)
#        ./updatecache --list-repertoire           same, for tour_guide.html?performer=<p>&tour=R-<show>
#                                                  (render with --festival / --promoter / --booksmerch / --repertoire [N];
#                                                  for repertoire a key is the show id, e.g. --repertoire debs-newbold-dauntless;
#                                                  a leading "R-" is fine, and the DEPRECATED "rep:" prefix is still tolerated)
#        ./updatecache --performer [N]             render N (default 1) uncached performers
#        ./updatecache --venue [N]                 render N (default 1) uncached venues
#        ./updatecache --storyclub [N]             render N (default 1) uncached story clubs
#                                                  one KV lookup, then N renders NT_DELAY seconds
#                                                  apart (default 12); stops if the daily quota runs out
#        ./updatecache --performer tis-tales       render just that key (works for every type above;
#                                                  several keys allowed; always re-renders, no KV
#                                                  lookup; spaces ok: --performer 'Jane Doe').
#                                                  Keys not in the events JSON are skipped, not
#                                                  rendered (NT_NO_CHECK=1 disables the check).
#                                                  Plural forms work too: --festivals 5
#        ./updatecache --performer tis-tales other-key --indexnow
#                                                  you EDITED these existing pages (no new keys, so --delta can't see them):
#                                                  same as above, but the render counts as a content update (the sitemap <lastmod>
#                                                  is stamped) and the pages that rendered OK are sent to IndexNow. Works with every
#                                                  type above (one type per command), explicit keys only. Pages that fail to render
#                                                  stay in ~/.updatecache-pending (rendered by the next --delta); if IndexNow doesn't
#                                                  accept them they wait in ~/.updatecache-indexnow for the next --indexnow run.
#        ./updatecache mypage.html                 refresh NOW (default)
#        ./updatecache 'performers.html?performer=abc'
#        ./updatecache https://newtroubadours.org/venues?venue=xyz
#
#   --list-performers    print every performer key that has no snapshot yet (one
#                        per line, URI-encoded as stored in KV), then a count on
#                        stderr. Renders nothing. Uses one KV list call (or a few
#                        if the store is large), no browser time.
#   --performer | --venue | --storyclub
#                        render ONE random page of that type that has no snapshot
#                        yet (lists the KV store, diffs it against the keys in
#                        events_normalized.json, renders one missing page).
#                        Needs jq, shuf and `npx wrangler login`. Set
#                        NT_KEYS_JQ_PERFORMER / _VENUE / _STORYCLUB to the jq
#                        filter that lists that type's keys in the JSON.
#   --stale <pages>      mark page(s) stale: keeps serving the old snapshot, uses
#                        NO browser time; the next prewarm run / render-tier bot
#                        request refreshes it (bot refreshes are rate-limited to
#                        about one per minute). Good for bulk edits or when the
#                        daily quota is gone.
#   --soft-purge-all     mark EVERY snapshot stale, delete nothing
#   --purge-only <pages> delete the snapshot(s): use for a bad render or a
#                        page that no longer exists
#   --purge <pages>      delete, then refresh now (risky if quota is out)
#   --hard-purge-all     treat EVERY snapshot as missing (asks for confirmation).
#                        Bots get the plain origin page until pages are re-rendered.
#
#   --force              (add to ANY rendering command) try the render even if the gatekeeper
#                        has a quota / 429 pause recorded. e.g.
#                        ./updatecache --performer halo-quin --indexnow --force
#                        If the quota really is gone it fails with a 429 again and stops; a
#                        success clears the pause for everyone.
#
# Default behaviour only force-renders. A successful render overwrites the stored
# snapshot. A failed one (rate limit / daily quota) keeps the old snapshot AND
# marks it stale (you'll see x-marked-stale: true), so the next prewarm run or
# bot request retries it automatically.
#
#   Auto-resolve: whenever a render comes back healthy (HTTP 200, x-page-health: ok, snapshot stored), that page's health-log
#   entries (the ones older than the render) are cleared when the command ends: one health-log listing per run, not one per page.
#   Pages that failed again keep their entries. NT_NO_AUTO_RESOLVE=1 turns it off; --resolved <page> does it by hand.
#
# Requires: export NT_DEBUG_SECRET=your-DEBUG_SECRET-value

HOST="newtroubadours.org"
SECRET="${NT_DEBUG_SECRET:?Set NT_DEBUG_SECRET first to the DEBUG_SECRET of the worker}"

# --force (anywhere on the command line): ask the gatekeeper to TRY the render even if it has a
# render pause / daily-quota flag recorded (sends x-ignore-pause). If Browser Run really is out
# of quota the render just fails with a 429 again and the run stops as usual. Works with every
# command that renders (--performer, --delta, --fill-missing, --refresh-stale, plain page names).
# Needs the gatekeeper.js that understands x-ignore-pause; an older worker simply ignores it.
FORCE=0
_args=()
for _a in "$@"; do
  if [ "$_a" = "--force" ]; then FORCE=1; else _args+=("$_a"); fi
done
set -- ${_args[@]+"${_args[@]}"}
unset _args _a
force_hdr=()
[ "$FORCE" = "1" ] && force_hdr=(-H "x-ignore-pause: $SECRET")

if [ "$1" = "--soft-purge-all" ]; then
  curl -s -w "  [HTTP %{http_code}]\n" -H "x-soft-purge: $SECRET" "https://$HOST/"
  exit 0
fi

if [ "$1" = "--hard-purge-all" ]; then
  echo "This makes EVERY snapshot count as missing. On the free plan it can take"
  echo "weeks to re-render them all. Consider --soft-purge-all instead."
  read -r -p "Type YES to continue: " answer
  [ "$answer" = "YES" ] || { echo "Cancelled."; exit 1; }
  curl -s -w "  [HTTP %{http_code}]\n" -H "x-hard-purge-all: $SECRET" "https://$HOST/"
  exit 0
fi

# Tour and repertoire-show dates (T-<tour>-yyyymmdd-<venue> / R-<show>-yyyymmdd-<venue>) mostly have NO eventId in the
# JSON: the site generates the id (shared_utils.js buildTourDateEventId / buildShowDateEventId). JQ_TOUR_DEFS
# reproduces that (an explicit eventId wins), so those pages are listed, rendered and put in the sitemap too.
JQ_TOUR_DEFS='def pad: tostring | if length < 2 then "0" + . else . end;
def ymd: (if type == "array" then .[0] else . end) | select(type == "string") | split("/") | select(length == 3) | map(tonumber? // empty) | select(length == 3) | "\(.[2])\(.[1] | pad)\(.[0] | pad)";
def vid: ((.venue_id // "") | if . == "" then "unknown-venue" else . end);
def tourevents:
  ((.tours // {}) | to_entries[] | .key as $k | (.value.tour_dates // [])[]
     | ((.eventId? | select(type == "string" and . != "")) // ((.date | ymd) as $d | "T-\($k)-\($d)-\(vid)"))),
  ((.repertoire_shows // {}) | to_entries[] | .key as $k | (.value.show_dates // [])[]
     | ((.eventId? | select(type == "string" and . != "")) // ((.date | ymd) as $d | "R-\($k)-\($d)-\(vid)")));
def allevents: (.. | objects | .eventId? | strings | select(. != "")), tourevents;
# yyyymmdd inside an id (T-/R-/structured ids), or from a legacy <name>-<epoch ms> id; empty if none
def evdate: (capture("(^|-)(?<d>20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01]))(-|$)").d) // (capture("-(?<ms>[0-9]{12,14})$").ms | tonumber / 1000 | floor | strftime("%Y%m%d"));'

# Build the valid-key index (what the gatekeeper stores as meta:keys) from the events JSON on stdin.
build_index() {
  jq -c "$JQ_TOUR_DEFS"'
    {
      performers: (.performers | keys),
      venues: (.venues | keys),
      promoters: (.promoters | keys),
      festivals: (.festivals | keys),
      # "R-" is the canonical repertoire prefix. "rep:" is DEPRECATED but kept in the index so any
      # stray legacy ?tour=rep:... request is not treated as an unknown key during the transition
      # (drop the second map once the Cloudflare 301 rep: -> R- has been live a while).
      tours: ((.tours | keys) + ((.repertoire_shows // {}) | keys | (map("R-" + .) + map("rep:" + .)))),
      # events: event ids (event.html?event=...) for the SITEMAP only (not a render gate): every event
      # dated within the last NT_SITEMAP_EVENT_DAYS (30) days or later; ids with no readable date are kept.
      events: ([allevents] | unique | map(select((evdate // "99999999") >= (now - 2592000 | strftime("%Y%m%d"))))),
      clubs: ([.clubs[].club?] + [.. | objects | .club? | strings]
              | map(select(type == "string" and . != "" and . != "other")) | unique)
    }'
}

# Download the events JSON to <outfile> and build the index from it into NEW_INDEX.
# Tries events_normalized.json, then events_normalised.json (or NT_EVENTS_JSON).
#   load_events_and_index <outfile>
load_events_and_index() {
  local name json_url
  NEW_INDEX=""
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    curl -sf --max-time 60 -o "$1" "$json_url" || continue
    NEW_INDEX=$(build_index < "$1" 2>/dev/null) && [ -n "$NEW_INDEX" ] && return 0
    NEW_INDEX=""
  done
  return 1
}

# --sync-keys: rebuild the valid-key index (meta:keys) the gatekeeper uses to
# skip renders for pages that don't exist. Run after events_normalized.json changes.
# (--delta does this for you, and also renders the new pages: see below.)
if [ "$1" = "--sync-keys" ]; then
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  tmpjson=$(mktemp "${TMPDIR:-/tmp}/updatecache-json.XXXXXX")
  load_events_and_index "$tmpjson" || { rm -f "$tmpjson"; echo "Could not build the key index (set NT_EVENTS_JSON?)" >&2; exit 1; }
  rm -f "$tmpjson"
  curl -s -w "  [HTTP %{http_code}]\n" -X POST -H "x-sync-keys: $SECRET" \
    --data "$NEW_INDEX" "https://$HOST/"
  exit 0
fi

# Progress line on stderr, only when stderr is a terminal (so pipes and $(...) stay clean).
note() { if [ -t 2 ]; then echo "$*" >&2; fi; }

# Run a command with a time limit (no GNU timeout needed, so it works on macOS). Its stdin is
# /dev/null, so npx/wrangler can never sit waiting for an answer to a prompt. Returns the
# command's status, or 128+ if it was killed for taking longer than SECS seconds.
#   run_with_timeout <secs> <command> [args...]
run_with_timeout() {
  local secs="$1" pid wd rc
  shift
  "$@" </dev/null &
  pid=$!
  ( sleep "$secs"; pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  wd=$!
  wait "$pid" 2>/dev/null
  rc=$?
  { kill "$wd"; wait "$wd"; } 2>/dev/null
  return $rc
}

# List the KV keys under a prefix and print them as a JSON array. wrangler can fail on its
# first call (expired login token being refreshed, npx install notice, a transient network
# error) or print noise before the JSON, so: start parsing at the first line that begins the
# JSON array, require a valid array, and retry. Each attempt is time-limited (NT_KV_TIMEOUT,
# default 60s) and wrangler's own messages stay visible on your terminal. If every attempt
# fails, stop instead of carrying on with an empty "cached" set (which would make every page
# look uncached and waste renders on pages that already have snapshots).
#   kv_list_json <prefix>
kv_list_json() {
  local prefix="$1" attempt out outfile rc secs="${NT_KV_TIMEOUT:-60}"
  outfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-kv-out.XXXXXX")
  note "Listing KV snapshots with wrangler (each attempt gives up after ${secs}s)..."
  for attempt in 1 2 3; do
    run_with_timeout "$secs" npx wrangler kv key list --namespace-id "$NT_KV_NAMESPACE_ID" --remote \
      --prefix "$prefix" >"$outfile"
    rc=$?
    # Keep only the JSON array: from the first line starting with "[" to its end
    # (a one-line "[...]", or a pretty-printed array closed by a line starting "]").
    out=$(awk '/^\[/ { s = 1 } s { print } s && (/^\]/ || /^\[.*\]$/) { exit }' "$outfile")
    if [ -n "$out" ] && printf '%s' "$out" | jq -e 'type == "array"' >/dev/null 2>&1; then
      rm -f "$outfile"
      printf '%s\n' "$out"
      return 0
    fi
    if [ "$rc" -ge 128 ]; then
      echo "wrangler did not answer within ${secs}s (attempt $attempt of 3)." >&2
    elif [ $attempt -lt 3 ]; then
      echo "KV lookup failed (attempt $attempt of 3); retrying..." >&2
    fi
    [ $attempt -lt 3 ] && sleep 3
  done
  echo "KV lookup failed after 3 attempts; stopping so nothing is rendered by mistake." >&2
  if [ -s "$outfile" ]; then echo "--- wrangler stdout (first 10 lines):" >&2; head -n 10 "$outfile" >&2; fi
  rm -f "$outfile"
  echo "If wrangler printed nothing above, run it by hand to see what it wants:" >&2
  echo "  npx wrangler kv key list --namespace-id $NT_KV_NAMESPACE_ID --remote | head" >&2
  echo "(npx wrangler whoami, or npx wrangler login, if it is an authentication problem)" >&2
  return 1
}

# Event ids carry their date as YYYYMMDD (e.g. R-some-show-20261112-some-venue). Reads ids on
# stdin and prints "YYYYMMDD<TAB>id" for those dated today or later (the upcoming ones).
upcoming_dated() {
  local today
  today=$(date +%Y%m%d)
  awk -v t="$today" 'match($0, /(^|-)(19|20)[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(-|$)/) {
    s = substr($0, RSTART, RLENGTH); gsub(/-/, "", s); if (s >= t) printf "%s\t%s\n", s, $0 }'
}

# ── auto-resolve: clear health-log entries of pages that re-rendered OK ──────────────────────────────
# render_one records the outcome of every render (ok = HTTP 200 with x-page-health: ok, and the snapshot was
# stored; anything else = bad). When the command ends (EXIT trap, also after Ctrl-C) autoresolve_flush looks at
# the LAST outcome per page and, for the ones that ended OK, deletes that page's health:* log entries that are
# older than the render: ONE listing of the log and one delete per entry, instead of a lookup per page.
# NT_NO_AUTO_RESOLVE=1 switches it off. (--resolved <page> does the same by hand.)
AUTORESOLVE_FILE=""
autoresolve_note() {
  [ "${NT_NO_AUTO_RESOLVE:-0}" = "1" ] && return 0
  local url="$1" result="$2" st=bad
  case "$result" in
    *"x-snapshot-kept: true"*|*"x-snapshot-stored: false"*|*x-marked-stale*|*x-quota-exhausted*|*x-render-paused*) st=bad ;;
    *"x-page-health: ok"*) case "$result" in *" 200"*) st=ok ;; esac ;;
  esac
  [ -n "$AUTORESOLVE_FILE" ] || AUTORESOLVE_FILE=$(mktemp "${TMPDIR:-/tmp}/updatecache-resolve.XXXXXX") || return 0
  printf '%s\t%s\t%s\n' "$st" "$(date +%s)" "$url" >> "$AUTORESOLVE_FILE"
}
autoresolve_flush() {
  local f="$AUTORESOLVE_FILE" oks map json names n=0 done_n=0 k
  AUTORESOLVE_FILE=""
  [ -n "$f" ] || return 0
  oks=$(awk -F'\t' 'NF >= 3 { last[$3] = $1 "\t" $2 } END { for (u in last) { split(last[u], a, "\t"); if (a[1] == "ok") print a[2] "\t" u } }' "$f")
  rm -f "$f"
  [ -n "$oks" ] || return 0
  command -v jq >/dev/null || return 0
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  json=$(kv_list_json "health:" 2>/dev/null) || { echo "Auto-resolve: could not read the health log; nothing cleared (try ./updatecache --resolved <page>)." >&2; return 0; }
  map=$(printf '%s\n' "$oks" | jq -Rn '[inputs | split("\t") | select(length >= 2)
          | { p: (.[1] | sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20")), t: (.[0] | tonumber) }
          | select(.p != "")] | reduce .[] as $e ({}; .[$e.p] = $e.t)')
  names=$(printf '%s\n' "$json" | jq -r --argjson m "$map" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    .[] | ((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm) as $p
        | select($m[$p] != null)
        | select(((.metadata.at // "") | sub("\\.[0-9]+"; "") | (try fromdateiso8601 catch 0)) <= ($m[$p] + 5))
        | .name')
  [ -n "$names" ] || return 0
  n=$(printf '%s\n' "$names" | grep -c .)
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    if run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key delete "$k" \
         --namespace-id "$NT_KV_NAMESPACE_ID" --remote >/dev/null 2>&1; then done_n=$((done_n + 1)); fi
  done <<< "$names"
  echo "Auto-resolved: cleared $done_n of $n health-log entr$([ "$n" -eq 1 ] && echo y || echo ies) for pages that re-rendered OK this run."
}

# Force-render one URL and print the status headers. Returns 1 if the daily
# browser quota is exhausted (so callers can stop).
#   render_one <url> <n>
render_one() {
  local url="$1" n="$2" result
  echo "[$n] === $url"
  # NT_MARK_UPDATED=1 (set only by --delta) also sends x-content-updated, which makes the gatekeeper
  # stamp this page's <lastmod> in the sitemap after a successful, healthy render. Routine refreshes
  # leave it unset, so they never move a lastmod.
  local upd_hdr=()
  [ "${NT_MARK_UPDATED:-0}" = "1" ] && upd_hdr=(-H "x-content-updated: $SECRET")
  # A 429 from the gatekeeper is either the DAILY quota (x-quota-exhausted: stop) or a short
  # back-off (x-render-paused: <seconds>: 2 min after the first 429 of the day, 20 min after the
  # second, 60 after the third). For a short one we wait it out and retry the same page once,
  # unless it is longer than NT_MAX_PAUSE_WAIT seconds (default 1500 = 25 min); then we stop.
  local attempt paused maxwait="${NT_MAX_PAUSE_WAIT:-1500}"
  # Minimum gap between ANY two renders, even across separate updatecache processes (--daily runs
  # --repair, --fill-missing and --refresh-stale as three processes, each of which skips the delay
  # before its own first render). The time of the last render is kept in a stamp file.
  local stamp="${NT_LAST_RENDER_FILE:-${TMPDIR:-/tmp}/updatecache-last-render}" _now _last _wait
  for attempt in 1 2; do
    _now=$(date +%s); _last=$(cat "$stamp" 2>/dev/null); _last="${_last:-0}"
    [[ "$_last" =~ ^[0-9]+$ ]] || _last=0
    _wait=$(( ${NT_DELAY:-12} - (_now - _last) ))
    if [ "$_wait" -gt 0 ]; then sleep "$_wait"; fi
    result=$(curl -s --max-time 120 -o /dev/null -D - -H "x-force-render: $SECRET" ${force_hdr[@]+"${force_hdr[@]}"} ${upd_hdr[@]+"${upd_hdr[@]}"} "$url" \
      | grep -iE '^(HTTP/|x-prerendered|x-quota-exhausted|x-render-paused|x-marked-stale|x-page-health|x-lastmod|x-snapshot-kept|x-snapshot-stored)' | tr -d '\r' | paste -sd' ' -)
    date +%s > "$stamp" 2>/dev/null
    echo "$result"
    case "$result" in *x-quota-exhausted*) break ;; esac
    paused=$(printf '%s' "$result" | sed -n 's/.*[Xx]-[Rr]ender-[Pp]aused: \([0-9]*\).*/\1/p')
    # With --force the gatekeeper already tried the render; waiting out the pause would be pointless.
    [ "$FORCE" = "1" ] && break
    [ -n "$paused" ] && [ "$attempt" -eq 1 ] && [ "$paused" -le "$maxwait" ] || break
    echo "  renders paused ${paused}s after a 429; waiting, then retrying this page once..." >&2
    sleep $((paused + 3))
  done
  # The gatekeeper only writes HEALTHY renders: an unhealthy one leaves the old snapshot in place (flagged
  # for retry) or, if there is none, stores nothing. Say so, because the render itself came back 200.
  case "$result" in
    *"x-snapshot-kept: true"*)   echo "  ⚠ page health is not ok: the OLD snapshot was kept (flagged for retry; see $0 --list-retry and --health)." >&2 ;;
    *"x-snapshot-stored: false"*) echo "  ⚠ page health is not ok and there is no old snapshot: nothing was cached (see $0 --health)." >&2 ;;
  esac
  autoresolve_note "$url" "$result"
  # --delta sets RENDERED_FILE: record URLs that rendered OK (HTTP 200, not marked stale, no quota hit,
  # and a healthy page). Only those are IndexNow'd; the rest stay pending and are retried next run.
  # Health comes from the gatekeeper's x-page-health header (absent = not checked = treated as fine):
  # error / loading / missing / stalled / 404 / notfound block it, and so does a "warn" whose reason
  # says the page showed its "not found" state. Other warnings are allowed.
  if [ -n "${RENDERED_FILE:-}" ]; then
    local health
    health=$(printf '%s' "$result" | sed -n 's/.*x-page-health: \([A-Za-z0-9\/]*\).*/\1/p')
    case "$health" in
      error|loading|missing|stalled|404|notfound) echo "  ⚠ not recorded as rendered (page health: $health): will stay pending, and won't be sent to IndexNow." >&2; return 0 ;;
      warn) case "$result" in *"not found"*) echo "  ⚠ not recorded as rendered (the page showed its 'not found' state): stays pending, not sent to IndexNow." >&2; return 0 ;; esac ;;
    esac
    case "$result" in
      *x-quota-exhausted*|*x-marked-stale*) ;;
      *" 200"*) printf '%s\n' "$url" >> "$RENDERED_FILE" ;;
    esac
  fi
  case "$result" in
    *x-quota-exhausted*) echo "Daily browser quota exhausted; stopping." >&2; return 1 ;;
    *x-render-paused*)   echo "Renders are paused after repeated 429s (longer than NT_MAX_PAUSE_WAIT); stopping. Run again later." >&2; return 1 ;;
  esac
  return 0
}

# Pages the gatekeeper recently logged as NOT healthy: the health:* keys that --health reads (it logs
# only renders that were not "ok": error / loading / missing / warn / 404). Prints a JSON object
# {"<page path?query>": <logged-at, ms>} with the latest entry per page, or {} if there is nothing or
# the log can't be read (then no prioritising happens, nothing else changes). Pages are normalised
# (scheme/host/leading slash removed, "+" -> %20) so they can be matched against page URLs.
# NT_HEALTH_DAYS = how far back to look (default 7, the log's own expiry); NT_NO_HEALTH_PRIORITY=1
# switches the whole feature off. Used by fill_one() and refresh_stale().
# Pages whose health problems are IGNORED everywhere the health log is read (--health, --daily's report,
# --repair / --refresh-stale priority, --staleness). A jq/regex matched against the page path+query
# (no leading slash). Override with NT_HEALTH_IGNORE='...'; NT_HEALTH_IGNORE='' ignores nothing.
HEALTH_IGNORE_DEFAULT='^(event_builder|stats)\.html'
unhealthy_pages_json() {
  if [ "${NT_NO_HEALTH_PRIORITY:-0}" = "1" ]; then echo '{}'; return 0; fi
  local hj out days="${NT_HEALTH_DAYS:-7}"
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  note "Reading the health log (to render pages whose last render was not healthy first)..."
  hj=$(kv_list_json "health:") || { echo "Could not read the health log; not prioritising unhealthy pages." >&2; echo '{}'; return 0; }
  out=$(printf '%s\n' "$hj" | jq -c --argjson d "$days" --arg ign "${NT_HEALTH_IGNORE-$HEALTH_IGNORE_DEFAULT}" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    def ms: ((.metadata.at // "") | sub("\\.[0-9]+"; "") | (try fromdateiso8601 catch 0)) * 1000;
    ((now - ($d * 86400)) * 1000) as $cut
    | [ .[] | select((.metadata.status // "") != "ok")
            | { p: ((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm), at: ms }
            | select(.at >= $cut and .p != "")
            | select($ign == "" or (.p | test($ign) | not)) ]
    | reduce .[] as $e ({}; .[$e.p] = ([(.[$e.p] // 0), $e.at] | max))' 2>/dev/null)
  [ -n "$out" ] || out='{}'
  printf '%s\n' "$out"
}

# Bookkeeping for explicit-key renders run with --indexnow (the pages were EDITED, so they are a
# content update). The caller has set UPD_DIR to a temp dir holding attempted.txt (every URL it
# tried) and ok.txt (those render_one recorded as rendered OK and healthy). Same lists as --delta:
# failures go on the pending list (the next --delta renders them), successes come off it, and
# rendered URLs wait in the unsubmitted list until IndexNow has accepted them.
update_finish() {
  local pending="${NT_PENDING_FILE:-$HOME/.updatecache-pending}"
  local unsub="${NT_UNSUBMITTED_FILE:-$HOME/.updatecache-indexnow}"
  local dt="$UPD_DIR" n_ok n_left n_unsub=0
  touch "$dt/ok.txt" "$dt/attempted.txt"
  grep -vxFf "$dt/ok.txt" "$dt/attempted.txt" > "$dt/failed.txt" || true
  { [ -s "$pending" ] && grep -vxFf "$dt/ok.txt" "$pending"; cat "$dt/failed.txt"; } \
    | awk 'NF && !seen[$0]++' > "$dt/pending.new"
  if [ -s "$dt/pending.new" ] || [ -e "$pending" ]; then cat "$dt/pending.new" > "$pending"; fi
  n_ok=$(grep -c . "$dt/ok.txt"); n_left=$(grep -c . "$dt/failed.txt")
  echo "Rendered OK: $n_ok. Not rendered: $n_left$( [ "$n_left" -gt 0 ] && echo " (added to $pending; ./updatecache --delta renders them later)")."
  if [ -s "$dt/ok.txt" ]; then
    cat "$dt/ok.txt" >> "$unsub"
    awk 'NF && !seen[$0]++' "$unsub" > "$dt/unsub.tmp" && mv "$dt/unsub.tmp" "$unsub"
  fi
  [ -s "$unsub" ] && n_unsub=$(grep -c . "$unsub")
  if [ "$n_unsub" -gt 0 ]; then
    if bash "$(cd "$(dirname "$0")" && pwd)/indexnow.sh" -f "$unsub"; then
      : > "$unsub"
    else
      echo "IndexNow did not accept everything; the $n_unsub URL(s) stay in $unsub for the next --indexnow run." >&2
    fi
  else
    echo "Nothing waiting to be sent to IndexNow."
  fi
}

# Render ONE random page of a given type that has no snapshot yet.
# With LIST_ONLY=1 it instead prints every uncached key and exits.
# With explicit keys (KEYS_GIVEN) it renders just those, with no KV lookup.
#   fill_one <page> <param> <default-jq> <jq-env-override>
fill_one() {
  local page="$1" param="$2" default_jq="$3" jq_override="$4"
  # Optional: rawmode=1 means the jq filter outputs complete, already-encoded
  # query tails ("performer-id&tour=R-show-id") instead of single keys, and
  # tag is a fixed string that picks this type's snapshots out of the shared page
  # (used for repertoire pages, which live on tour_guide.html next to real tours).
  local rawmode="${5:-0}" tag="${6:-}"
  # prefer_upcoming=1 (events): uncached ids whose date is today or later come first.
  local prefer_upcoming="${7:-0}"
  local what="$param"; [ "$rawmode" = "1" ] && what="repertoire"

  # --indexnow only makes sense for pages you name (they are the ones you edited).
  if [ "${INDEXNOW:-0}" = "1" ] && [ "${LIST_ONLY:-0}" != "1" ] && [ ${#KEYS_GIVEN[@]} -eq 0 ]; then
    echo "--indexnow needs explicit keys, e.g. ./updatecache --$what some-key --indexnow" >&2
    exit 1
  fi

  # Explicit keys given (e.g. ./updatecache --performer tis-tales): render just
  # those, after checking each is a real key in the events JSON (unknown keys
  # are skipped and no render is spent). Re-renders even if a snapshot exists.
  if [ "${LIST_ONLY:-0}" != "1" ] && [ ${#KEYS_GIVEN[@]} -gt 0 ]; then
    command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
    local k raw enc valid="" n=0 skipped=0 vname vurl ok hint url stopped=0
    # --indexnow: treat this run as a content update (stamp <lastmod>) and record what rendered OK.
    UPD_DIR=""
    if [ "${INDEXNOW:-0}" = "1" ]; then
      UPD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/updatecache-update.XXXXXX")
      trap 'autoresolve_flush; rm -rf "$UPD_DIR"' EXIT
      : > "$UPD_DIR/ok.txt"; : > "$UPD_DIR/attempted.txt"
      RENDERED_FILE="$UPD_DIR/ok.txt"
      NT_MARK_UPDATED=1
    fi
    if [ "${NT_NO_CHECK:-0}" != "1" ] || [ "$rawmode" = "1" ]; then
      for vname in events_normalized events_normalised; do
        vurl="${NT_EVENTS_JSON:-https://$HOST/$vname.json}"
        valid=$(curl -sf --max-time 60 "$vurl" | jq -r "${!jq_override:-$default_jq}" 2>/dev/null)
        [ -n "$valid" ] && break
      done
      [ -n "$valid" ] || { echo "Could not load the valid $param keys; nothing rendered. (NT_NO_CHECK=1 skips the check.)" >&2; exit 1; }
    fi
    for k in "${KEYS_GIVEN[@]}"; do
      # Compare the decoded key: a key containing % is treated as URL-encoded.
      if [[ "$k" == *%* ]]; then raw=$(printf '%b' "${k//%/\\x}"); else raw="$k"; fi
      ok=1; enc=""
      if [ "$rawmode" = "1" ]; then
        # Composite keys: the key given is the show id (a leading "R-" is
        # fine, as is the DEPRECATED "rep:"); find its full "performer&tour=..." query
        # in the valid list.
        if [[ "$raw" == R-* ]]; then raw="${raw#R-}"; else raw="${raw#rep:}"; fi
        enc=$(printf '%s\n' "$valid" | awk -v s="${tag}$(jq -rn --arg k "$raw" '$k|@uri')" \
          'length($0) >= length(s) && substr($0, length($0) - length(s) + 1) == s { print; exit }')
        [ -n "$enc" ] || ok=0
      elif [ "${NT_NO_CHECK:-0}" != "1" ] && ! printf '%s\n' "$valid" | grep -Fxq -- "$raw"; then
        ok=0
      fi
      if [ $ok -eq 0 ]; then
        hint=" (NT_NO_CHECK=1 to render anyway)"; [ "$rawmode" = "1" ] && hint=""
        echo "Skipping '$k': not a known key for $page.html$hint." >&2
        skipped=$((skipped + 1))
        continue
      fi
      [ $n -gt 0 ] && sleep "$DELAY"
      n=$((n + 1))
      # Raw keys are URL-encoded here ("Jane Doe" -> Jane%20Doe); a key that
      # already contains a % is assumed to be encoded and used as given.
      if [ "$rawmode" != "1" ]; then
        if [[ "$k" == *%* ]]; then enc="$k"; else enc=$(jq -rn --arg k "$k" '$k|@uri'); fi
      fi
      url="https://$HOST/$page.html?$param=$enc"
      [ -n "$UPD_DIR" ] && printf '%s\n' "$url" >> "$UPD_DIR/attempted.txt"
      render_one "$url" "$n" || { stopped=1; break; }
    done
    [ $skipped -gt 0 ] && echo "$skipped key(s) skipped as invalid." >&2
    if [ -n "$UPD_DIR" ]; then
      unset RENDERED_FILE NT_MARK_UPDATED
      [ $stopped -eq 1 ] && echo "Stopped early: keys after the one that stopped were not rendered. Run again for them." >&2
      update_finish
    fi
    exit 0
  fi

  # Paste the 32-char id from `npx wrangler kv namespace list`
  # (title: newtroubadours-render-cache). Can be overridden via the environment.
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  [ "$NT_KV_NAMESPACE_ID" != "PASTE_NAMESPACE_ID_HERE" ] || {
    echo "Edit updatecache and set NT_KV_NAMESPACE_ID (npx wrangler kv namespace list)" >&2; exit 1; }

  # jq filter that outputs one key per line. ADJUST to your JSON shape.
  local jq_keys="${!jq_override:-$default_jq}"
  local prefix="render:https://$HOST/$page.html?$param="
  local uri_filter="| @uri"; [ "$rawmode" = "1" ] && uri_filter=""
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

  local all cached key name json_url
  note "Fetching the events JSON..."
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    # The worker builds its KV keys with URLSearchParams, which encodes a space as
    # "+", leaves "*" alone and encodes "~" as %7E (jq's @uri does the opposite).
    # Convert so these keys match the stored KV key names exactly.
    all=$(curl -sf --max-time 60 "$json_url" | jq -r "$jq_keys $uri_filter" 2>/dev/null \
      | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g' | sort -u)
    [ -n "$all" ] && break
  done
  [ -n "$all" ] || { echo "No $param keys found; set $jq_override to the right jq filter" >&2; exit 1; }

  local kvjson
  read_epochs
  kvjson=$(kv_list_json "$prefix") || exit 1
  # Snapshots older than the last hard purge are treated as missing by the
  # gatekeeper, so they count as uncached here too.
  cached=$(printf '%s\n' "$kvjson" \
    | jq -r --arg p "$prefix" --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name | ltrimstr($p)' \
    | { if [ -n "$tag" ]; then grep -F -- "$tag"; else cat; fi; } | sort -u)

  local missing up_dated up_ids rest_ids nup=0 upnote="" bad_ids="" other_ids="" nbad=0
  missing=$(comm -23 <(echo "$all") <(echo "$cached"))
  if [ -n "$missing" ] && [ "$prefer_upcoming" = "1" ]; then
    up_dated=$(printf '%s\n' "$missing" | upcoming_dated)
    nup=$(printf '%s' "$up_dated" | grep -c .)
    up_ids=$(printf '%s' "$up_dated" | cut -f2-)
    if [ "$nup" -gt 0 ]; then
      rest_ids=$(comm -23 <(printf '%s\n' "$missing" | sort) <(printf '%s\n' "$up_ids" | sort))
    else
      rest_ids="$missing"
    fi
    upnote=" ($nup upcoming)"
  fi

  # Then (after upcoming events, which only the events type has) pages whose last render the
  # gatekeeper logged as NOT healthy: they are the ones most worth re-rendering. See
  # unhealthy_pages_json(). Everything else follows, still in random order.
  local pool hfile bnote=""
  pool="$missing"; [ "$prefer_upcoming" = "1" ] && pool="$rest_ids"
  other_ids="$pool"
  if [ -n "$pool" ]; then
    hfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-health.XXXXXX")
    unhealthy_pages_json | jq -r 'keys[]' > "$hfile" 2>/dev/null
    if [ -s "$hfile" ]; then
      bad_ids=$(printf '%s\n' "$pool" | awk -v pre="$page.html?$param=" \
        'NR == FNR { h[$0] = 1; next } { k = $0; gsub(/\+/, "%20", k); if ((pre k) in h) print $0 }' "$hfile" -)
      if [ -n "$bad_ids" ]; then
        other_ids=$(comm -23 <(printf '%s\n' "$pool" | sort) <(printf '%s\n' "$bad_ids" | sort))
        nbad=$(printf '%s\n' "$bad_ids" | grep -c .)
        bnote=" "
      fi
    fi
    rm -f "$hfile"
  fi
  upnote="${upnote}${bnote}"

  if [ "${LIST_ONLY:-0}" = "1" ]; then
    if [ -n "$missing" ]; then
      if [ "$prefer_upcoming" = "1" ]; then
        # Upcoming first, soonest first, then not-ok health, then the rest.
        { [ "$nup" -gt 0 ] && printf '%s\n' "$up_dated" | sort | cut -f2-
          [ -n "$bad_ids" ] && printf '%s\n' "$bad_ids"
          [ -n "$other_ids" ] && printf '%s\n' "$other_ids"; }
      else
        { [ -n "$bad_ids" ] && printf '%s\n' "$bad_ids"
          [ -n "$other_ids" ] && printf '%s\n' "$other_ids"; }
      fi
      echo "$(echo "$missing" | wc -l | tr -d ' ') of $(echo "$all" | wc -l | tr -d ' ') $what pages have no snapshot$upnote." >&2
    else
      echo "All $what pages already have snapshots." >&2
    fi
    exit 0
  fi

  # One KV lookup above; now render up to COUNT random uncached pages from it,
  # spaced DELAY seconds apart (free-plan Browser Run allows ~1 render per 10s).
  # For events, random upcoming ones first, then random others.
  local keys total result i=0
  [ -n "$missing" ] || { echo "All $what pages already have snapshots."; exit 0; }
  total=$(echo "$missing" | wc -l | tr -d ' ')
  if [ "$prefer_upcoming" = "1" ]; then
    keys=$({ [ "$nup" -gt 0 ] && printf '%s\n' "$up_ids" | shuf
             [ -n "$bad_ids" ] && printf '%s\n' "$bad_ids" | shuf
             [ -n "$other_ids" ] && printf '%s\n' "$other_ids" | shuf; } | head -n "$COUNT")
    echo "$total $what pages have no snapshot$upnote; rendering up to $COUNT, upcoming first, then not-ok health (one every ${DELAY}s)."
  else
    keys=$({ [ -n "$bad_ids" ] && printf '%s\n' "$bad_ids" | shuf
             [ -n "$other_ids" ] && printf '%s\n' "$other_ids" | shuf; } | head -n "$COUNT")
    echo "$total $what pages have no snapshot$upnote; rendering up to $COUNT$( [ "$nbad" -gt 0 ] && echo ", not-ok health first") (one every ${DELAY}s)."
  fi

  while IFS= read -r key; do
    [ $i -gt 0 ] && sleep "$DELAY"
    i=$((i + 1))
    key="${key//+/%20}"   # back to %20 for the request URL (a literal + is already %2B)
    render_one "https://$HOST/$page.html?$param=$key" "$i" || break
  done <<< "$keys"
  exit 0
}

# jq filters that list each page type's keys in events_normalized.json
# (each can be overridden with NT_KEYS_JQ_<TYPE>, e.g. NT_KEYS_JQ_BOOKSMERCH).
JQ_PERFORMER='.performers | keys[]'
JQ_VENUE='.venues | keys[]'
JQ_STORYCLUB='[.clubs[].club] | unique | .[]'
JQ_FESTIVAL='.festivals | keys[]'
JQ_PROMOTER='.promoters | keys[]'
JQ_BOOKSMERCH='.performers | to_entries[] | select(((.value.books // []) | length) > 0 or ((.value.merch // []) | length) > 0) | .key'
# Event pages are event.html?event=<eventId>. Every "eventId" string anywhere in the JSON
# counts (regular events and repertoire show_dates alike), so this doesn't depend on where
# events live. If your ids sit under another field name, set NT_KEYS_JQ_EVENT.
# (JQ_TOUR_DEFS is defined near the top, above build_index.)
JQ_EVENT="$JQ_TOUR_DEFS"' [allevents] | unique | .[]'
# Repertoire pages are tour_guide.html?performer=<performer>&tour=R-<show>. Each key in
# .repertoire_shows is a show id; its performer is the longest performer id that is a
# prefix of it (e.g. debs-newbold-dauntless -> debs-newbold). Shows with no matching
# performer are left out. The output is the complete, already-encoded query tail.
JQ_REPERTOIRE='(.performers | keys) as $p | (.repertoire_shows // {} | keys[]) as $k | ([$p[] | . as $x | select($k | startswith($x + "-"))] | sort_by(length) | last) as $perf | select($perf != null) | "\($perf | @uri)&tour=\("R-" + $k | @uri)"'

# --status: cached / uncached counts for every page type. One download of the
# events JSON and ONE KV listing; no renders, no browser time.
#   status_row <label> <page> <param> <default-jq> <jq-env-override>
status_row() {
  local label="$1" page="$2" param="$3" default_jq="$4" jq_override="$5"
  local rawmode="${6:-0}" tag="${7:-}" uri_filter="| @uri"; [ "$rawmode" = "1" ] && uri_filter=""
  local jq_keys="${!jq_override:-$default_jq}"
  local prefix="render:https://$HOST/$page.html?$param="
  local all cached nall ncached nextra
  all=$(echo "$STATUS_JSON" | jq -r "$jq_keys $uri_filter" 2>/dev/null \
    | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g' | sort -u)
  cached=$(echo "$STATUS_NAMES" \
    | awk -v p="$prefix" 'index($0, p) == 1 { print substr($0, length(p) + 1) }' \
    | { if [ -n "$tag" ]; then grep -F -- "$tag"; else cat; fi; } | sort -u)
  nall=$(echo "$all" | grep -c .)
  ncached=$(comm -12 <(echo "$all") <(echo "$cached") | grep -c .)
  nextra=$(comm -13 <(echo "$all") <(echo "$cached") | grep -c .)
  printf '%-12s %7s %9s %7s %7s\n' "$label" "$ncached" "$((nall - ncached))" "$nall" "$nextra"
}

status_all() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local name json_url
  STATUS_JSON=""
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    STATUS_JSON=$(curl -sf --max-time 60 "$json_url") && [ -n "$STATUS_JSON" ] && break
    STATUS_JSON=""
  done
  [ -n "$STATUS_JSON" ] || { echo "Could not fetch the events JSON (set NT_EVENTS_JSON?)" >&2; exit 1; }
  local statusjson
  read_epochs
  statusjson=$(kv_list_json "render:https://$HOST/") || exit 1
  STATUS_NAMES=$(printf '%s\n' "$statusjson" \
    | jq -r --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name')
  printf '%-12s %7s %9s %7s %7s\n' type cached uncached total orphans
  status_row performers  performers  performer "$JQ_PERFORMER"   NT_KEYS_JQ_PERFORMER
  status_row venues      venues      venue     "$JQ_VENUE"       NT_KEYS_JQ_VENUE
  status_row storyclubs  storyclub   club      "$JQ_STORYCLUB"   NT_KEYS_JQ_STORYCLUB
  status_row festivals   festival    festival  "$JQ_FESTIVAL"    NT_KEYS_JQ_FESTIVAL
  status_row promoters   promoters   promoter  "$JQ_PROMOTER"    NT_KEYS_JQ_PROMOTER
  status_row booksmerch  books_merch performer "$JQ_BOOKSMERCH"  NT_KEYS_JQ_BOOKSMERCH
  status_row repertoire  tour_guide  performer "$JQ_REPERTOIRE"  NT_KEYS_JQ_REPERTOIRE 1 "&tour=R-"
  status_row events      event       event     "$JQ_EVENT"       NT_KEYS_JQ_EVENT
  echo "(orphans = snapshots whose key is no longer in the JSON; 'cached' counts any stored snapshot, stale or not,"
  echo " but not ones older than the last hard purge, which the gatekeeper treats as missing; see --staleness)" >&2
  exit 0
}

# An event page whose id is dated more than 30 days ago (the sitemap's cut-off) is an "old event": it is
# allowed to fade away, so it is looked at LAST. Works on a KV listing entry (needs .name).
JQ_OLD_EVENT_DEFS='def evdate: ((capture("(^|-)(?<d>20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01]))(-|$)").d)
                              // (capture("-(?<ms>[0-9]{12,14})$").ms | tonumber / 1000 | floor | strftime("%Y%m%d")));
  def isold: ([ .name | capture("/event\\.html\\?event=(?<e>[^&]*)") | .e ] | .[0]) as $e
             | if $e == null then false
               else (([ $e | try evdate catch empty ] | .[0]) as $d | ($d != null and $d < (now - 2592000 | strftime("%Y%m%d")))) end;
  '

# ── staleness report ────────────────────────────────────────────────────────
# Mirrors the gatekeeper's policy (gatekeeper.js): a snapshot is STALE when its ts is
# older than FRESH_SECONDS (120h) or older than the soft-purge epoch, and counts as
# MISSING when its ts is older than the hard-purge epoch (both live in the KV key
# meta:epochs). The gatekeeper stores ts as KV metadata and sets a KV expiry on every
# write, so ONE key listing gives every page's age and expiry with no per-key reads.
FRESH_HOURS="${NT_FRESH_HOURS:-120}"            # gatekeeper FRESH_SECONDS, in hours
TTL_DAYS="${NT_TTL_DAYS:-90}"                  # gatekeeper KV_TTL_SECONDS, in days
TTL_MS=$(( TTL_DAYS * 86400000 ))
EXPIRY_WARN_HOURS="${NT_EXPIRY_WARN_HOURS:-120}"
# A snapshot's age: the ts the gatekeeper stored as KV metadata or, when the key listing has
# no metadata (snapshots written before the gatekeeper stored it), the write time implied by
# the KV expiry: every write sets expirationTtl = KV_TTL_SECONDS, so written = expiry - TTL.
# entry_est is true when the age had to be derived from the expiry. Needs --argjson ttl.
JQ_TS_DEF='def entry_ts: (.metadata.ts // (if .expiration != null then (.expiration * 1000 - $ttl) else null end));
  def entry_est: ((.metadata.ts == null) and (.expiration != null));
  '
EPOCH_SOFT=0; EPOCH_HARD=0; EPOCH_NOTE=""; EPOCHS_READ=""

# Read the purge epochs ({"soft":ms,"hard":ms}; 0 = never purged). One KV read per run.
read_epochs() {
  [ -n "$EPOCHS_READ" ] && return 0
  EPOCHS_READ=1
  command -v jq >/dev/null || return 0
  local out
  note "Reading the purge epochs..."
  out=$(run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get meta:epochs \
          --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null \
        | awk '/^\{/ { s = 1 } s { print } s && /\}$/ { exit }')
  if [ -n "$out" ] && printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1; then
    EPOCH_SOFT=$(printf '%s' "$out" | jq -r '(.soft // 0) | floor')
    EPOCH_HARD=$(printf '%s' "$out" | jq -r '(.hard // 0) | floor')
  else
    EPOCH_NOTE="no meta:epochs found (never purged), or it could not be read"
  fi
}

fmt_epoch() {
  if [ "$1" -gt 0 ] 2>/dev/null; then
    jq -rn --argjson ms "$1" '$ms / 1000 | floor | strftime("%Y-%m-%d %H:%M UTC")'
  else
    echo "never"
  fi
}

# One row per page type, same classification as the gatekeeper:
#   invalid = ts older than the hard purge (served as missing)
#   stale   = ts older than the soft purge or older than the fresh window
#   fresh   = everything else
#   est     = age estimated from the KV expiry (the listing has no ts metadata)
#   unk     = neither ts metadata nor an expiry, so no age at all
JQ_STALE_ROWS='
  def kind:
    (.name | ltrimstr($base)) as $r
    | ($r | split("?")[0]) as $path
    | if $path == "/tour_guide.html" and ($r | test("tour=(R-|rep%3A)")) then $path + " (rep)" else $path end;
  [ .[] | select(.name | startswith($base))
        | { kind: kind, ts: entry_ts, est: entry_est, exp: (.expiration // null), h: (.metadata.health // ""), r: ((.metadata.retry // 0) == 1) } ]
  | group_by(.kind)[]
  | . as $g
  | [ $g[0].kind,
      ($g | length),
      ([ $g[] | select(.ts != null and .ts >= $hard and .ts >= $soft and ($now - .ts) <= $fresh) ] | length),
      ([ $g[] | select(.ts != null and .ts >= $hard and (.ts < $soft or ($now - .ts) > $fresh)) ] | length),
      ([ $g[] | select(.ts != null and .ts < $hard) ] | length),
      ([ $g[] | select(.est) ] | length),
      ([ $g[] | select(.ts == null) ] | length),
      ([ $g[] | select(.ts != null and .ts > 0 and .ts >= $hard) | ($now - .ts) ] | max // -1),
      ([ $g[] | select(.exp != null and (.exp * 1000 - $now) < $soon) ] | length),
      ([ $g[] | select(.h == "ok") ] | length),
      ([ $g[] | select(.h != "" and .h != "ok" and .h != "n/a") ] | length),
      ([ $g[] | select(.h == "") ] | length),
      ([ $g[] | select(.h == "n/a") ] | length),
      ([ $g[] | select(.r) ] | length)
    ] | @tsv'

# marked-stale (ts=0), soft-purged, aged-out, hard-purged, expiring soon, total stored, age estimated
JQ_STALE_BREAKDOWN='
  [ .[] | select(.name | startswith($base)) | entry_ts | select(. != null) ] as $t
  | [ ([ $t[] | select(. == 0 and . >= $hard) ] | length),
      ([ $t[] | select(. > 0 and . >= $hard and . < $soft) ] | length),
      ([ $t[] | select(. > 0 and . >= $hard and . >= $soft and ($now - .) > $fresh) ] | length),
      ([ $t[] | select(. < $hard) ] | length),
      ([ .[] | select(.name | startswith($base)) | select(.expiration != null and (.expiration * 1000 - $now) < $soon) ] | length),
      ([ .[] | select(.name | startswith($base)) ] | length),
      ([ .[] | select(.name | startswith($base)) | select(entry_est) ] | length)
    ] | @tsv'

staleness_report() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  local now_ms=$(( $(date +%s) * 1000 ))
  local fresh_ms=$(( FRESH_HOURS * 3600000 )) soon_ms=$(( EXPIRY_WARN_HOURS * 3600000 ))
  local json rows marked softp aged invalid expiring stored est stale
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  local args=(--arg base "render:https://$HOST" --argjson now "$now_ms" --argjson fresh "$fresh_ms"
              --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD" --argjson soon "$soon_ms"
              --argjson ttl "$TTL_MS")
  rows=$(printf '%s\n' "$json" | jq -r "${args[@]}" "$JQ_TS_DEF $JQ_STALE_ROWS")
  [ -n "$rows" ] || { echo "No snapshots are stored under render:https://$HOST/"; exit 0; }
  read -r marked softp aged invalid expiring stored est \
    <<< "$(printf '%s\n' "$json" | jq -r "${args[@]}" "$JQ_TS_DEF $JQ_STALE_BREAKDOWN")"
  stale=$(( marked + softp + aged ))

  echo "Gatekeeper policy (from gatekeeper.js; set NT_FRESH_HOURS / NT_TTL_DAYS if you change the constants):"
  printf '  %-13s %s\n' "fresh window" "${FRESH_HOURS}h: older snapshots are still served, flagged stale"
  printf '  %-13s %s\n' "KV expiry" "${TTL_DAYS}d after the last write: then the page counts as uncached"
  printf '  %-13s %s\n' "soft purge" "$(fmt_epoch "$EPOCH_SOFT"): snapshots older than this count as stale"
  printf '  %-13s %s\n' "hard purge" "$(fmt_epoch "$EPOCH_HARD"): snapshots older than this count as missing"
  [ -n "$EPOCH_NOTE" ] && echo "  ($EPOCH_NOTE)"
  echo
  printf '%s\n' "$rows" | awk -F'\t' -v warn="$EXPIRY_WARN_HOURS" '
    function age(ms) { if (ms < 0) return "-"; if (ms >= 86400000) return sprintf("%.1fd", ms / 86400000); return sprintf("%.1fh", ms / 3600000) }
    BEGIN { mx = -1; printf "%-24s %6s %6s %6s %7s %5s %4s %7s %8s %6s %6s %6s %5s %5s\n", "page", "stored", "fresh", "stale", "invalid", "est", "unk", "oldest", "exp<" warn "h", "ok", "notok", "noflag", "n/a", "retry" }
    NF { printf "%-24s %6d %6d %6d %7d %5d %4d %7s %8d %6d %6d %6d %5d %5d\n", $1, $2, $3, $4, $5, $6, $7, age($8), $9, $10, $11, $12, $13, $14
         for (i = 2; i <= 7; i++) t[i] += $i; t[9] += $9; t[10] += $10; t[11] += $11; t[12] += $12; t[13] += $13; t[14] += $14; if ($8 + 0 > mx) mx = $8 + 0 }
    END { printf "%-24s %6d %6d %6d %7d %5d %4d %7s %8d %6d %6d %6d %5d %5d\n", "TOTAL", t[2], t[3], t[4], t[5], t[6], t[7], age(mx), t[9], t[10], t[11], t[12], t[13], t[14] }'
  echo "(est = age estimated from the KV expiry; unk = no age available; oldest ignores marked-stale pages;
 ok / notok / noflag = the page-health the gatekeeper stored with the snapshot: ok, error|warn|loading|missing|404,
 or no flag because it was written before health was recorded; n/a = pages without a health LED, such as the
 home page, index.html and stats.html, which are fine and never flagged; retry = kept on an OLD snapshot
 because the latest render was not healthy, see --list-retry)"
  echo
  echo "Stale: $stale of $stored  (aged past ${FRESH_HOURS}h: $aged, soft-purged: $softp, marked stale with ts=0: $marked)"
  if [ "$est" -gt 0 ]; then
    echo "Ages: $est of $stored are estimated from the KV expiry (written = expiry - ${TTL_DAYS}d) because the key"
    echo "  listing has no ts metadata for them. That is accurate for pages the gatekeeper wrote, but a page marked"
    echo "  stale (ts=0) can only be spotted where its metadata is present."
  fi
  echo "Invalid (hard-purged, served as missing): $invalid.   Expiring within ${EXPIRY_WARN_HOURS}h: $expiring"
  # Pages whose last logged render was not healthy (the log only holds non-ok renders), how many are
  # stored here and how many of those are also stale. These are refreshed first by --refresh-stale.
  local hbad hstored hstale
  hbad=$(unhealthy_pages_json)
  read -r hstored hstale <<< "$(printf '%s\n' "$json" | jq -r --argjson bad "$hbad" "${args[@]}" "$JQ_TS_DEF"'
    def pg: .name | ltrimstr($base + "/") | gsub("\\+"; "%20");
    [ .[] | select(.name | startswith($base)) | select($bad[pg] != null) ] as $b
    | "\($b | length) \([ $b[] | entry_ts as $t | select($t != null and ($t < $hard or $t < $soft or ($now - $t) > $fresh)) ] | length)"' 2>/dev/null)"
  echo "Not-ok health (last ${NT_HEALTH_DAYS:-7}d log): $(printf '%s' "$hbad" | jq 'length') pages logged; ${hstored:-?} have a stored snapshot, ${hstale:-?} of those are stale"
  local nretry ncapped
  read -r nretry ncapped <<< "$(printf '%s\n' "$json" | jq -r --argjson cap "${NT_MAX_RETRIES:-3}" '[ .[] | select((.metadata.retry // 0) == 1) ] as $r | "\($r | length) \([ $r[] | select((.metadata.fails // 0) >= $cap) ] | length)"' 2>/dev/null)"
  echo "Kept on an old snapshot after an unhealthy render (retry flag): ${nretry:-0}, of which ${ncapped:-0} at the retry cap (see: $0 --list-retry)"
  awk -v n="$(( stale + invalid ))" 'BEGIN { printf "Refreshing all %d stale/invalid pages = about %d x 2s = %.1f min of browser time (free plan: 10 min/day, shared with crawlers).\n", n, n, n * 2 / 60 }'
  echo
  echo "How the gatekeeper treats them:"
  echo "  - Stale snapshots are still served to bots (x-prerender-stale: true); nothing is lost while they wait."
  echo "  - A stale page is refreshed only when a render-tier bot (Bing, DuckDuckGo, Apple, social-preview bots)"
  echo "    requests that exact page, its key is in the meta:keys index, and it wins the one-per-minute render"
  echo "    slot; or when you (or a prewarm) force-render it. Googlebot, Yandex, Baidu and Yahoo never trigger one."
  echo "  - Invalid pages are treated as missing: bots get the plain origin page until the page is re-rendered."
  echo "  - Marking a page stale (--stale, or a failed forced render) sets ts=0 but restarts its ${TTL_DAYS}d KV expiry."
  echo "  - List the worst offenders with: ./updatecache --list-stale 20"
  exit 0
}

# Pages the health log lists as NOT healthy that have NO stored snapshot (an unhealthy render is never stored, so a
# page that has never rendered healthily lives only in the log). Prints their request URLs, one per line. Used by
# --repair (and so --daily) so such pages are retried too, even when they are not in the sitemap. Left out: 404s
# (crawlers asking for paths that are not pages), anything that is not an .html page, NT_HEALTH_IGNORE pages, and with
# --skip-capped (arg 2 = 1) pages that were unhealthy on NT_MAX_RETRIES (3) or more different days: they need a
# data/page fix, then a by-hand render. NT_NO_LOGGED_RENDER=1 turns this off.
#   logged_without_snapshot <render: KV listing json> <skipcap 0|1>
logged_without_snapshot() {
  local snapjson="$1" skipcap="${2:-0}" hj
  [ "${NT_NO_LOGGED_RENDER:-0}" = "1" ] && return 0
  [ "${NT_NO_HEALTH_PRIORITY:-0}" = "1" ] && return 0
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  hj=$(kv_list_json "health:" 2>/dev/null) || return 0
  printf '%s\n' "$hj" | jq -r --argjson snap "$snapjson" --arg base "render:https://$HOST" --arg host "https://$HOST" \
      --argjson d "${NT_HEALTH_DAYS:-7}" --argjson cap "${NT_MAX_RETRIES:-3}" --argjson skipcap "$skipcap" \
      --arg ign "${NT_HEALTH_IGNORE-$HEALTH_IGNORE_DEFAULT}" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    def ms: ((.metadata.at // "") | sub("\\.[0-9]+"; "") | (try fromdateiso8601 catch 0)) * 1000;
    ($snap | map(select(.name | startswith($base)) | (.name | ltrimstr($base + "/") | gsub("\\+"; "%20")) | {(.): true}) | add // {}) as $have
    | ((now - ($d * 86400)) * 1000) as $cut
    | [ .[] | { p: ((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm),
                at: ms, day: ((.metadata.at // "")[0:10]), st: (.metadata.status // "") }
            | select(.st != "ok" and .at >= $cut and .p != "") ]
    | group_by(.p)
    | map({ p: .[0].p, days: (map(.day) | unique | length), last: max_by(.at) })
    | .[]
    | select(.last.st != "404")
    | select(.p | test("^[A-Za-z0-9_-]+\\.html(\\?|$)"))
    | select($ign == "" or ((.p | test($ign)) | not))
    | select($have[.p] == null)
    | select($skipcap == 0 or .days < $cap)
    | $host + "/" + .p' 2>/dev/null
}

# --list-stale [N]: the N stalest pages (default 20), oldest first, as full URLs.
# "Stale" = needs a refresh: stale by the gatekeeper's policy, or hard-purged. Feed the
# list straight back in:  ./updatecache $(./updatecache --list-stale 20)
list_stale() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local n=20 type="" a
  for a in "$@"; do
    if [[ "$a" =~ ^[0-9]+$ ]]; then [ "$a" -ge 1 ] && n="$a"
    elif [ "$a" = "--all" ]; then n=999999
    elif [ -n "$a" ]; then type="$a"; fi
  done
  type_pattern "$type" || { echo "Unknown type '$type' (performer venue storyclub festival promoter booksmerch repertoire tour media event)" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  local now_ms=$(( $(date +%s) * 1000 )) fresh_ms=$(( FRESH_HOURS * 3600000 )) json all
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  local jqargs=(--arg base "render:https://$HOST" --argjson now "$now_ms"
      --argjson fresh "$fresh_ms" --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD"
      --argjson ttl "$TTL_MS")
  all=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" "$JQ_TS_DEF"'
      [ .[] | select(.name | startswith($base)) | { name: .name, ts: entry_ts }
            | select(.ts != null)
            | select(.ts < $hard or .ts < $soft or ($now - .ts) > $fresh) ]
      | sort_by(.ts) | .[] | .name | ltrimstr("render:")')
  if [ -n "$PAT" ]; then all=$(printf '%s\n' "$all" | grep -E -- "$PAT"); fi
  if [ -n "$XPAT" ]; then all=$(printf '%s\n' "$all" | grep -v -E -- "$XPAT"); fi
  [ -n "$all" ] || { echo "No stale ${type:-page} snapshots." >&2; exit 0; }
  echo "$(printf '%s\n' "$all" | wc -l | tr -d ' ') ${type:-page} snapshot(s) need a refresh; listing the oldest $n." >&2
  printf '%s\n' "$all" | head -n "$n"
  exit 0
}

# --refresh-stale [N] [type]: force-render N RANDOM stale pages (default 20), optionally only of one
# type. Same definition of "stale" as list_stale() above (kept as its own copy of that query so
# list_stale is untouched). The arguments can come in either order: a number is N, a word is the type.
#   type: performer venue storyclub festival promoter booksmerch repertoire tour media event (none = any page)
# Renders are NT_DELAY seconds apart (default 12) and stop if the daily browser quota runs out; a
# failed render keeps the old snapshot (and marks it stale), so a rerun just tries again.
refresh_stale() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local n=20 type="" pat="" xpat="" a do_idx=0 notok=0 onlybad=0 unfl=0 oldest=0 nobad=0 skipcap=0 oldmode=0
  for a in "$@"; do
    if [ "$a" = "--indexnow" ]; then
      do_idx=1
    elif [ "$a" = "--all" ]; then
      n=999999                      # no cap: refresh every candidate
    elif [ "$a" = "--skip-bad" ]; then
      nobad=1                       # leave out the not-ok / retry-flagged pages (another step already handles them)
    elif [ "$a" = "--skip-capped" ]; then
      skipcap=1                     # leave out retry-flagged pages that hit the retry cap (broken at source: fix the data)
    elif [ "$a" = "--no-old-events" ]; then
      oldmode=1                     # leave out event pages dated more than 30 days ago (--daily looks at them last)
    elif [ "$a" = "--old-events-only" ]; then
      oldmode=2                     # ONLY event pages dated more than 30 days ago
    elif [ "$a" = "--oldest" ]; then
      oldest=1                      # oldest snapshots first within each priority group, instead of random
    elif [ "$a" = "--not-ok" ]; then
      notok=1                       # candidates = stale OR not-ok/unflagged (even if still fresh)
    elif [ "$a" = "--only-bad" ]; then
      onlybad=1; notok=1            # repair mode: candidates = ONLY pages reported not ok, stale or not
    elif [ "$a" = "--unflagged" ]; then
      unfl=1                        # with --only-bad: also pages that have no health flag at all
    elif [[ "$a" =~ ^[0-9]+$ ]]; then
      [ "$a" -ge 1 ] && n="$a"
    elif [ -n "$a" ]; then
      type="$a"
    fi
  done
  case "$type" in
    "")                       pat="" ;;
    performer|performers)     pat='/performers\.html\?performer=' ;;
    venue|venues)             pat='/venues\.html\?venue=' ;;
    storyclub|storyclubs)     pat='/storyclub\.html\?club=' ;;
    festival|festivals)       pat='/festival\.html\?festival=' ;;
    promoter|promoters)       pat='/promoters\.html\?promoter=' ;;
    booksmerch)               pat='/books_merch\.html\?' ;;   # performer=, publisher= and view= variants
    repertoire|repertoires)   pat='/tour_guide\.html\?(.*&)?tour=(R-|rep%3A)' ;;   # incl. legacy tour=rep:<show> keys
    tour|tours)               pat='/tour_guide\.html\?(.*&)?tour='; xpat='tour=(R-|rep%3A)' ;;   # real tours: everything except repertoire
    media)                    pat='/media\.html' ;;
    event|events)             pat='/event\.html\?event=' ;;
    *) echo "Unknown type '$type' (performer venue storyclub festival promoter booksmerch repertoire tour media event)" >&2; exit 1 ;;
  esac
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  local now_ms=$(( $(date +%s) * 1000 )) fresh_ms=$(( FRESH_HOURS * 3600000 )) json all picks total count url i=0
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  local jqargs=(--arg base "render:https://$HOST" --argjson now "$now_ms"
      --argjson fresh "$fresh_ms" --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD"
      --argjson ttl "$TTL_MS")
  # --not-ok widens the candidates from "stale" to "stale OR not ok": a snapshot whose own health
  # flag is not ok/n/a (incl. none at all) or whose last logged render was unhealthy, even if fresh.
  local hbad_json="{}"
  [ $notok -eq 1 ] && hbad_json=$(unhealthy_pages_json 2>/dev/null); [ -n "$hbad_json" ] || hbad_json="{}"
  jqargs+=(--argjson skipcap "$skipcap" --argjson cap "${NT_MAX_RETRIES:-3}" --argjson notok "$notok" --argjson onlybad "$onlybad" --argjson unfl "$unfl" --argjson hbad "$hbad_json" --arg ign "${NT_HEALTH_IGNORE-$HEALTH_IGNORE_DEFAULT}" --argjson oldmode "$oldmode")
  all=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" "$JQ_TS_DEF $JQ_OLD_EVENT_DEFS"'
      def pg: .name | ltrimstr($base + "/") | gsub("\\+"; "%20");
      def isstale: entry_ts != null and (entry_ts < $hard or entry_ts < $soft or ($now - entry_ts) > $fresh);
      def flagged: ((.metadata.retry // 0) == 1);   # old page kept after an unhealthy render (gatekeeper retry flag)
      def capped: flagged and ((.metadata.fails // 0) >= $cap);
      def logbad: ($hbad[pg] != null) and ($hbad[pg] > (entry_ts // 0));   # logged AFTER the current snapshot was written
      def isbad: ((.metadata.health // "") as $h | $h != "ok" and $h != "n/a") or logbad or flagged;
      def explicitbad: ((.metadata.health // "") as $h | $h != "" and $h != "ok" and $h != "n/a") or logbad or flagged;
      def noflag: (.metadata.health // "") == "";
      [ .[] | select(.name | startswith($base))
            | select($skipcap == 0 or (capped | not))
            | select($ign == "" or ((pg | test($ign)) | not))   # NT_HEALTH_IGNORE: pages we do not care about
            | select($oldmode == 0 or ((isold) == ($oldmode == 2)))
            | select(if $onlybad == 1 then (explicitbad or ($unfl == 1 and noflag))
                     else (isstale or flagged or ($notok == 1 and isbad)) end)
            | { name: .name, ts: (entry_ts // 0) } ]
      | sort_by(.ts) | .[] | .name | ltrimstr("render:")')
  # --repair: pages the health log lists that have no snapshot at all are candidates too (they can only be repaired by
  # rendering them; they are not in the KV listing, so the query above never sees them).
  local extra=""
  if [ $onlybad -eq 1 ] && [ $nobad -eq 0 ]; then
    extra=$(logged_without_snapshot "$json" "$skipcap")
    [ -n "$extra" ] && all=$(printf '%s\n%s\n' "$all" "$extra" | grep .)
  fi
  [ -n "$all" ] || { if [ $onlybad -eq 1 ]; then echo "Nothing reported as not ok$([ $unfl -eq 1 ] || echo ' (add --unflagged to include pages with no health flag)')." >&2; else echo "No stale$([ $notok -eq 1 ] && echo '/not-ok') snapshots." >&2; fi; exit 0; }
  # Stale snapshots with no page-health "ok" flag in their own KV metadata (the gatekeeper stores
  # metadata.health on every snapshot it writes: ok|warn|error|loading|missing|404|n/a). Snapshots
  # written before it did so have no flag at all, and count as "not ok" until they are re-rendered.
  # "n/a" (home page, index, stats: no health LED) is fine and is not prioritised.
  local snapbad
  snapbad=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" "$JQ_TS_DEF"'
      .[] | select(.name | startswith($base)) | select(((.metadata.health // "") as $h | $h != "ok" and $h != "n/a") or ((.metadata.retry // 0) == 1))
          | select($notok == 1 or ((.metadata.retry // 0) == 1) or (entry_ts != null and (entry_ts < $hard or entry_ts < $soft or ($now - entry_ts) > $fresh)))
          | .name | ltrimstr("render:")')
  if [ -n "$pat" ]; then
    all=$(printf '%s\n' "$all" | grep -E -- "$pat")
    [ -n "$xpat" ] && all=$(printf '%s\n' "$all" | grep -v -E -- "$xpat")
    [ -n "$all" ] || { echo "No stale$([ $notok -eq 1 ] && echo '/not-ok') ${type} snapshots." >&2; exit 0; }
  fi
  total=$(printf '%s\n' "$all" | wc -l | tr -d ' ')
  # Priority tiers (NT_NO_HEALTH_PRIORITY=1 turns the tiers off):
  #   1. explicitly NOT ok: the gatekeeper's problem log lists the page, or its snapshot health flag is
  #      error / warn / loading / missing / 404
  #   2. no "ok" flag at all (snapshots written before the gatekeeper stored metadata.health)
  #   3. everything else (plain stale pages)
  # Each tier is shuffled on its own; the picks are tier 1, then 2, then 3, cut at N.
  local tier1="" tier2="" rest="$all" nbad=0 nnone=0 snapnone="" snapbad_flag="" logjson
  logjson=$(unhealthy_pages_json 2>/dev/null); [ -n "$logjson" ] || logjson="{}"
  # The problem log is append-only (entries live 7 days, a later healthy render never removes them), so a
  # logged problem only counts while it is NEWER than the page's current snapshot. A page that was re-rendered
  # since (snapshot ts > log time) has been dealt with; if that render was bad too, its own health flag says so.
  if [ "$logjson" != "{}" ]; then
    tier1=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" --argjson hlog "$logjson" "$JQ_TS_DEF"'
        def pg: .name | ltrimstr($base + "/") | gsub("\\+"; "%20");
        .[] | select(.name | startswith($base))
            | select(($hlog[pg] != null) and ($hlog[pg] > (entry_ts // 0)))
            | .name | ltrimstr("render:")')
  fi
  # snapshots with no health flag (tier 2) vs an explicit not-ok flag (tier 1), restricted to the chosen type
  if [ -n "$pat" ]; then snapbad=$(printf '%s\n' "$snapbad" | grep -E -- "$pat"); fi
  if [ -n "$xpat" ]; then snapbad=$(printf '%s\n' "$snapbad" | grep -v -E -- "$xpat"); fi
  if [ -n "$snapbad" ]; then
    snapnone=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" "$JQ_TS_DEF"'
        .[] | select(.name | startswith($base)) | select((.metadata.health // "") == "" and ((.metadata.retry // 0) != 1))
            | .name | ltrimstr("render:")' | grep -x -F -f <(printf '%s\n' "$snapbad"))
    if [ -n "$snapnone" ]; then
      snapbad_flag=$(printf '%s\n' "$snapbad" | grep -v -x -F -f <(printf '%s\n' "$snapnone"))
    else
      snapbad_flag="$snapbad"
    fi
    tier1=$(printf '%s\n%s\n' "$tier1" "$snapbad_flag" | grep . | sort -u)
    tier2=$(printf '%s\n' "$snapnone" | grep . | sort -u)
    # a page in the problem log is tier 1 even if its snapshot has no flag
    [ -n "$tier1" ] && [ -n "$tier2" ] && tier2=$(printf '%s\n' "$tier2" | grep -v -x -F -f <(printf '%s\n' "$tier1"))
  fi
  # no-snapshot pages from the health log are unhealthy by definition: tier 1
  if [ -n "$extra" ]; then tier1=$(printf '%s\n%s\n' "$tier1" "$extra" | grep . | sort -u); fi
  # only ever render candidates (in repair mode the unflagged ones are not candidates unless --unflagged)
  tier1=$(printf '%s\n' "$tier1" | grep -x -F -f <(printf '%s\n' "$all") || true)
  tier2=$(printf '%s\n' "$tier2" | grep -x -F -f <(printf '%s\n' "$all") || true)
  if [ $nobad -eq 1 ]; then
    all=$(printf '%s\n' "$all" | grep -v -x -F -f <(printf '%s\n' "$tier1" | grep .) || printf '%s\n' "$all")
    tier1=""
  fi
  nbad=$(printf '%s\n' "$tier1" | grep -c .)
  nnone=$(printf '%s\n' "$tier2" | grep -c .)
  rest=$(printf '%s\n' "$all" | grep -v -x -F -f <(printf '%s\n%s\n' "$tier1" "$tier2" | grep .) || true)
  # Build the full ordered list first; the N cut (and the old-events-last reorder) happens afterwards.
  local n_req="$n" oldurls=""; n=999999
  if [ $oldest -eq 1 ]; then
    # $all is already oldest-first. Not-ok / retry-flagged pages (tier 1) still come first; after them
    # purely by age, so a snapshot close to its 90-day expiry is never held back by a younger page
    # that merely lacks a health flag.
    if [ -n "${NT_NO_HEALTH_PRIORITY:-}" ] || [ -z "$tier1" ]; then
      picks=$(printf '%s\n' "$all" | head -n "$n")
    else
      picks=$({ printf '%s\n' "$all" | grep -x -F -f <(printf '%s\n' "$tier1")
                printf '%s\n' "$all" | grep -v -x -F -f <(printf '%s\n' "$tier1"); } | head -n "$n")
    fi
  elif [ -n "${NT_NO_HEALTH_PRIORITY:-}" ]; then
    picks=$(printf '%s\n' "$all" | shuf | head -n "$n")
  else
    picks=$({ [ -n "$tier1" ] && printf '%s\n' "$tier1" | shuf
              [ -n "$tier2" ] && printf '%s\n' "$tier2" | shuf
              [ -n "$rest" ] && printf '%s\n' "$rest" | shuf; } | head -n "$n")
  fi
  # Plain stale event pages dated more than 30 days ago go LAST (see below: unhealthy ones do not).
  oldurls=$(printf '%s\n' "$json" | jq -r "${jqargs[@]}" "$JQ_TS_DEF $JQ_OLD_EVENT_DEFS"'
      .[] | select(.name | startswith($base)) | select(isold) | .name | ltrimstr("render:")')
  # Unhealthy pages (tier 1: not ok / retry-flagged) are ALWAYS repaired first, old events included: only plain
  # stale old events are pushed to the end.
  if [ -n "$oldurls" ] && [ -n "$tier1" ]; then
    oldurls=$(printf '%s\n' "$oldurls" | grep -v -x -F -f <(printf '%s\n' "$tier1") || true)
  fi
  if [ -n "$oldurls" ]; then
    picks=$({ printf '%s\n' "$picks" | grep -v -x -F -f <(printf '%s\n' "$oldurls")
              printf '%s\n' "$picks" | grep -x -F -f <(printf '%s\n' "$oldurls"); } | grep . | head -n "$n_req")
  else
    picks=$(printf '%s\n' "$picks" | head -n "$n_req")
  fi
  n="$n_req"
  count=$(printf '%s\n' "$picks" | wc -l | tr -d ' ')
  if [ $onlybad -eq 1 ]; then
    echo "Repair: $nbad ${type:-page}(s) reported not ok$([ $unfl -eq 1 ] && echo ", $nnone with no health flag"); re-rendering $count (one every ${DELAY}s). A page whose data/code is really broken will just come back not ok: check with --health."
  else
    echo "$total candidate ${type:-page}(s): $nbad not ok, $nnone with no ok flag, rest plain stale; rendering $count in that order$([ $oldest -eq 1 ] && echo ', oldest first after the not-ok ones') (one every ${DELAY}s)."
  fi

  # --indexnow: remember which URLs rendered OK (render_one records HTTP 200, not marked stale, no
  # quota hit, healthy page) so only those are submitted, exactly as --delta does.
  local okfile=""
  if [ $do_idx -eq 1 ]; then
    okfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-refresh.XXXXXX")
    trap 'autoresolve_flush; rm -f "$okfile"' EXIT
    RENDERED_FILE="$okfile"
  fi

  while IFS= read -r url; do
    [ -n "$url" ] || continue
    [ $i -gt 0 ] && sleep "$DELAY"
    i=$((i + 1))
    url="${url//+/%20}"   # KV keys store a space as +; back to %20 for the request URL (a literal + is already %2B)
    case "$url" in *tour=rep%3A*)
      echo "  (legacy key: rendering its R- page instead; the old tour=rep: snapshot stays stale until you delete it: ./updatecache --purge-only '$url')"
      url="${url//tour=rep%3A/tour=R-}" ;;
    esac
    render_one "$url" "$i" || break
  done <<< "$picks"
  unset RENDERED_FILE

  if [ $do_idx -eq 1 ]; then
    # Same waiting list --delta uses, so URLs left over from an earlier --delta whose IndexNow call
    # failed are sent now too, and a failed submission here stays queued for the next --indexnow run.
    local unsub="${NT_UNSUBMITTED_FILE:-$HOME/.updatecache-indexnow}" tmp n_unsub=0
    if [ -s "$okfile" ]; then
      tmp=$(mktemp "${TMPDIR:-/tmp}/updatecache-unsub.XXXXXX")
      cat "$unsub" "$okfile" 2>/dev/null | awk 'NF && !seen[$0]++' > "$tmp" && mv "$tmp" "$unsub"
    fi
    [ -s "$unsub" ] && n_unsub=$(grep -c . "$unsub")
    if [ "$n_unsub" -gt 0 ]; then
      if bash "$(cd "$(dirname "$0")" && pwd)/indexnow.sh" -f "$unsub"; then
        : > "$unsub"
      else
        echo "IndexNow did not accept everything; the $n_unsub URL(s) stay in $unsub for the next --indexnow run." >&2
      fi
    else
      echo "Nothing waiting to be sent to IndexNow."
    fi
  fi
  exit 0
}

# --list-cached [file] [type]: every snapshot URL in the cache, sorted, one per line. With a file
# name they are written there (a one-line count is printed); without one they go to stdout. A type
# word (same ones as --refresh-stale) limits it to that page type. Stale snapshots ARE included
# (they are still served); snapshots whose stored time is older than the last hard purge are NOT,
# because the gatekeeper treats those as missing (the same rule --status uses). NOTE: a page marked
# stale has its stored time set to 0, so once a hard purge has ever happened, marked-stale pages
# fall under that rule too and are left out (as the gatekeeper also treats them as missing).
list_cached() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local out="" type="" pat="" a all n json
  for a in "$@"; do
    case "$a" in
      performer|performers|venue|venues|storyclub|storyclubs|festival|festivals|promoter|promoters|booksmerch|repertoire|repertoires|event|events) type="$a" ;;
      *) out="$a" ;;
    esac
  done
  case "$type" in
    "")                       pat="" ;;
    performer|performers)     pat='/performers\.html\?performer=' ;;
    venue|venues)             pat='/venues\.html\?venue=' ;;
    storyclub|storyclubs)     pat='/storyclub\.html\?club=' ;;
    festival|festivals)       pat='/festival\.html\?festival=' ;;
    promoter|promoters)       pat='/promoters\.html\?promoter=' ;;
    booksmerch)               pat='/books_merch\.html\?' ;;
    repertoire|repertoires)   pat='/tour_guide\.html\?(.*&)?tour=(R-|rep%3A)' ;;   # incl. legacy tour=rep:<show> keys
    event|events)             pat='/event\.html\?event=' ;;
  esac
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  read_epochs
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  all=$(printf '%s\n' "$json" | jq -r --arg base "render:https://$HOST" --argjson hard "$EPOCH_HARD" \
      --argjson ttl "$TTL_MS" "$JQ_TS_DEF"'
      .[] | select(.name | startswith($base))
          | select((entry_ts // $hard) >= $hard)
          | .name | ltrimstr("render:")' | sort)
  if [ -n "$pat" ]; then all=$(printf '%s\n' "$all" | grep -E -- "$pat"); fi
  n=$(printf '%s\n' "$all" | grep -c .)
  if [ "$n" -eq 0 ]; then echo "No cached ${type:-page} snapshots." >&2; exit 0; fi
  if [ -n "$out" ]; then
    printf '%s\n' "$all" > "$out" || { echo "Could not write $out" >&2; exit 1; }
    echo "$n cached URL(s) written to $out"
  else
    printf '%s\n' "$all"
    echo "$n cached URL(s)." >&2
  fi
  exit 0
}

# --list-recent [H]: snapshots written in the last H hours (default 12), newest first, as full
# URLs. For cleaning up after a bad deploy: save the list, then --purge-only and/or re-render it.
# The write time is the ts the gatekeeper stored as KV metadata, or the time implied by the KV
# expiry when there is no metadata. Pages marked stale (ts=0) are not included.
list_recent() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local hours=12
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && hours="$1"
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local now_ms=$(( $(date +%s) * 1000 )) json all
  local cutoff_ms=$(( now_ms - hours * 3600000 ))
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  all=$(printf '%s\n' "$json" | jq -r --arg base "render:https://$HOST" --argjson cutoff "$cutoff_ms" \
      --argjson ttl "$TTL_MS" "$JQ_TS_DEF"'
      [ .[] | select(.name | startswith($base)) | { name: .name, ts: entry_ts }
            | select(.ts != null and .ts >= $cutoff) ]
      | sort_by(.ts) | reverse | .[] | .name | ltrimstr("render:")')
  [ -n "$all" ] || { echo "No snapshots were written in the last ${hours}h." >&2; exit 0; }
  echo "$(printf '%s\n' "$all" | wc -l | tr -d ' ') snapshot(s) written in the last ${hours}h." >&2
  printf '%s\n' "$all"
  exit 0
}

# --inspect <type> <key>: why does the gatekeeper see (or not see) this page? Checks, in order:
# 1. is the key in the events JSON (what --list-*, --status and the render options use),
# 2. is it in the worker's meta:keys index (what lets crawlers trigger a render),
# 3. which snapshots exist in KV for it, including look-alike keys (other host, path or letter
#    case) that the gatekeeper would never read, because it looks up one exact key.
inspect_key() {
  local page="$1" param="$2" index_name="$3" default_jq="$4" jq_override="$5" key="$6" cmd="$7"
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local jq_keys="${!jq_override:-$default_jq}" raw="$key" enc expected name vurl valid="" near idx
  local json rows exact_state others needle now_ms
  [[ "$key" == *%* ]] && raw=$(printf '%b' "${key//%/\\x}")
  # The KV key the gatekeeper builds (URLSearchParams encoding: space = +, ~ = %7E).
  enc=$(jq -rn --arg k "$raw" '$k | @uri' | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g')
  expected="render:https://$HOST/$page.html?$param=$enc"
  echo "Page:   https://$HOST/$page.html?$param=$enc"
  echo "KV key: $expected"
  echo

  # 1. events JSON
  for name in events_normalized events_normalised; do
    vurl="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    valid=$(curl -sf --max-time 60 "$vurl" | jq -r "$jq_keys" 2>/dev/null)
    [ -n "$valid" ] && break
  done
  if [ -z "$valid" ]; then
    echo "1. events JSON: could not load the $param keys (set NT_EVENTS_JSON?)"
  elif printf '%s\n' "$valid" | grep -Fxq -- "$raw"; then
    echo "1. events JSON: yes, '$raw' is a known $param key"
  else
    near=$(printf '%s\n' "$valid" | grep -Fix -- "$raw" | head -n 1)
    if [ -n "$near" ]; then
      echo "1. events JSON: NO exact match, but '$near' differs only by letter case"
    else
      echo "1. events JSON: NO, '$raw' is not one of the $param keys, so $0 --status/--list-*/$cmd never look at it"
    fi
  fi

  # 2. the worker's valid-key index
  if [ -n "$index_name" ]; then
    note "Reading the worker's key index..."
    idx=$(run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get meta:keys \
            --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null \
          | awk '/^\{/ { s = 1 } s { print }')
    if ! printf '%s' "$idx" | jq -e 'type == "object"' >/dev/null 2>&1; then
      echo "2. worker key index (meta:keys): not found or unreadable, so the worker ALLOWS crawler renders of any key (run $0 --sync-keys)"
    elif ! printf '%s' "$idx" | jq -e --arg n "$index_name" 'has($n)' >/dev/null 2>&1; then
      echo "2. worker key index: has no '$index_name' list, so crawler renders of any key are allowed (run $0 --sync-keys)"
    elif printf '%s' "$idx" | jq -e --arg n "$index_name" --arg k "$raw" '.[$n] | any(. == $k)' >/dev/null 2>&1; then
      echo "2. worker key index: yes, crawlers may trigger a render of it"
    else
      echo "2. worker key index: NO, crawler requests get miss-origin-unknown-key and are never rendered (run $0 --sync-keys if it is new)"
    fi
  else
    echo "2. worker key index: the worker has no key check for this page type, so crawler renders are always allowed"
  fi

  # 3. snapshots in KV (any host, path or letter case)
  read_epochs
  now_ms=$(( $(date +%s) * 1000 ))
  json=$(kv_list_json "render:") || exit 1
  needle=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
  rows=$(printf '%s\n' "$json" | jq -r --arg n "$needle" --arg exp "$expected" --argjson now "$now_ms" \
      --argjson ttl "$TTL_MS" --argjson fresh "$(( FRESH_HOURS * 3600000 ))" \
      --argjson soft "$EPOCH_SOFT" --argjson hard "$EPOCH_HARD" "$JQ_TS_DEF"'
    def r1: ((. * 10 | round) / 10);
    .[]
    | select((.name | ascii_downcase) | contains($n))
    | entry_ts as $ts
    | (if $ts == null then "unknown"
       elif $ts < $hard then "invalid"
       elif ($ts < $soft or ($now - $ts) > $fresh) then "stale"
       else "fresh" end) as $state
    | [ (if .name == $exp then "EXACT" else "other" end),
        $state,
        ( (.name | ltrimstr("render:"))
          + "  |  " + (if $ts == null then "age unknown"
                       else "written " + ((($now - $ts) / 3600000) | r1 | tostring) + "h ago" + (if entry_est then " (est. from expiry)" else "" end) end)
          + "  |  " + ((.metadata.bytes // "?") | tostring) + " bytes"
          + "  |  " + (if .expiration == null then "no expiry"
                       else "expires in " + ((((.expiration * 1000) - $now) / 86400000) | r1 | tostring) + "d" end)
          + "  |  " + $state ) ]
    | @tsv')
  echo "3. snapshots in KV whose key contains '$raw' (any host, path or letter case):"
  if [ -z "$rows" ]; then
    echo "   none"
  else
    printf '%s\n' "$rows" | awk -F'\t' '{ printf "   %s%s\n", ($1 == "EXACT" ? "[exact key]  " : "[look-alike] "), $3 }'
  fi
  exact_state=$(printf '%s\n' "$rows" | awk -F'\t' '$1 == "EXACT" { print $2; exit }')
  others=$(printf '%s\n' "$rows" | awk -F'\t' '$1 == "other"' | grep -c .)
  echo
  case "$exact_state" in
    fresh)   echo "Verdict: a fresh snapshot exists under the exact key, so a bot request is a hit." ;;
    stale)   echo "Verdict: the exact key is present but stale: bots are served it, and a render-tier bot may trigger a refresh." ;;
    invalid) echo "Verdict: the exact key is present but older than the last hard purge, so the gatekeeper treats it as MISSING." ;;
    unknown) echo "Verdict: the exact key is present but its age is unknown." ;;
    *)
      if [ "$others" -gt 0 ]; then
        echo "Verdict: nothing under the exact key. The gatekeeper reads only that key, so a request that arrives with a"
        echo "different host, path or letter case misses even though a look-alike snapshot exists."
      else
        echo "Verdict: no snapshot under any key, so a bot request is a miss. Render it with: $0 $cmd '$raw'"
      fi ;;
  esac
  echo "(KV changes can take up to about a minute to show at other locations, and a recent 'not found' can be cached briefly.)"
  exit 0
}

inspect_cmd() {
  local type="${1:-}" key="${2:-}"
  if [ -z "$type" ] || [ -z "$key" ]; then
    echo "Usage: $0 --inspect <performer|venue|storyclub|festival|promoter|event|booksmerch> <key>" >&2
    exit 1
  fi
  case "$type" in
    performer|performers) inspect_key performers performer performers "$JQ_PERFORMER" NT_KEYS_JQ_PERFORMER "$key" --performer ;;
    venue|venues)         inspect_key venues venue venues "$JQ_VENUE" NT_KEYS_JQ_VENUE "$key" --venue ;;
    storyclub|storyclubs) inspect_key storyclub club clubs "$JQ_STORYCLUB" NT_KEYS_JQ_STORYCLUB "$key" --storyclub ;;
    festival|festivals)   inspect_key festival festival festivals "$JQ_FESTIVAL" NT_KEYS_JQ_FESTIVAL "$key" --festival ;;
    promoter|promoters)   inspect_key promoters promoter promoters "$JQ_PROMOTER" NT_KEYS_JQ_PROMOTER "$key" --promoter ;;
    event|events)         inspect_key event event "" "$JQ_EVENT" NT_KEYS_JQ_EVENT "$key" --event ;;
    booksmerch)           inspect_key books_merch performer "" "$JQ_BOOKSMERCH" NT_KEYS_JQ_BOOKSMERCH "$key" --booksmerch ;;
    *) echo "Unknown type '$type' (performer venue storyclub festival promoter event booksmerch)" >&2; exit 1 ;;
  esac
}

# --health [DAYS]: renders the gatekeeper flagged as unhealthy. The gatekeeper writes one
# health:<day>:<page> key per page per day (only when the render was not "ok") with the details in
# the key's metadata, so one key listing is enough. Pages without a health LED (index, stats,
# the tool pages) are never logged, except "404" (bots asking for paths that don't exist).
#   status: error = a JS error / failed check on the page; loading = never finished rendering;
#           missing = the page's health script never ran; warn = rendered with a warning
#           (e.g. its "not found" state); 404 = the 404 page was rendered.
health_report() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local days=7 json rows
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && days="$1"
  json=$(kv_list_json "health:") || exit 1
  rows=$(printf '%s\n' "$json" | jq -r --argjson d "$days" --arg ign "${NT_HEALTH_IGNORE-$HEALTH_IGNORE_DEFAULT}" '
    (now - ($d * 86400) | todate) as $cut
    | [ .[] | select((.metadata.at // "") >= $cut)
            | select($ign == "" or (((.metadata.page // .name) | tostring | sub("^https?://[^/]+/?"; "") | sub("^/"; "")) | test($ign) | not)) ]
    | sort_by(.metadata.at) | reverse | .[]
    | [ (.metadata.at // "?"), (.metadata.status // "?"), (.metadata.why // "?"),
        (.metadata.page // .name), (.metadata.reason // "") ] | @tsv')
  if [ -z "$rows" ]; then
    echo "No unhealthy renders logged in the last ${days} day(s)."
    echo "(The log only has renders from after the gatekeeper's health logging was deployed; entries expire after 7 days.)"
    exit 0
  fi
  printf '%s\n' "$rows" | awk -F'\t' '
    BEGIN { printf "%-17s %-8s %-11s %s\n", "when (UTC)", "status", "trigger", "page  --  reason" }
    { n[$2]++; t = substr($1, 1, 16); sub("T", " ", t)
      printf "%-17s %-8s %-11s %s%s\n", t, $2, $3, $4, ($5 != "" ? "  --  " $5 : "") }
    END { s = ""; for (k in n) s = s sprintf("%s: %d  ", k, n[k]); printf "\n%s\n", s }'
  exit 0
}

# ── sitemap gap check ──────────────────────────────────────────────────────
# The sitemap is the list of pages crawlers are TOLD about (the worker generates it from meta:keys), so it
# is the right yardstick for "does every page a bot can find have a snapshot in KV?". The base pages
# (no ?args: index.html, performers.html, ...) are not in the sitemap, so they are added to the check.
# These helpers compare both with the KV listing, exactly as the gatekeeper will look pages up.

# Same list as prewarm.yml renders first. "" is the home page.
BASE_PAGES=(
  "" index.html event_guide.html tour_guide.html storyclub.html performers.html venues.html
  festival.html flyers.html media.html promoters.html books_merch.html stats.html
)

# The sitemap's URLs, one per line, XML-unescaped. The legacy tour=rep:<show> form is folded into
# tour=R-<show>, as the gatekeeper does, so both share one snapshot.
sitemap_urls() {
  curl -sf --max-time 30 "https://$HOST/sitemap.xml" \
    | grep -o '<loc>[^<]*</loc>' \
    | sed -e 's/<loc>//' -e 's/<\/loc>//' \
          -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e "s/&apos;/'/g" -e 's/&amp;/\&/g' \
    | sed -e 's/tour=rep%3A/tour=R-/'
}

# stdin: URLs (sitemap style, encodeURIComponent). stdout: the same URLs in the form the gatekeeper stores
# them under (URLSearchParams encoding: space = +, ~ = %7E, and ! ' ( ) are percent-encoded).
sitemap_kvform() {
  sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/!/%21/g' -e "s/'/%27/g" -e 's/(/%28/g' -e 's/)/%29/g'
}

# Checks the base pages + sitemap URLs against KV. Writes the URLs with no usable snapshot to <missing-file>
# (base pages first) and one "<page type><TAB>hit|miss" line per URL to <table-file>; sets SM_TOTAL / SM_MISSING.
# (Call it directly, not inside $(...), so the variables survive.) Snapshots older than the last hard
# purge count as missing, as in --status.
sitemap_gap() {
  local out="$1" tab="$2" tmp kvjson p
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/updatecache-sitemap.XXXXXX")
  note "Fetching sitemap.xml..."
  sitemap_urls > "$tmp/sm.txt"
  if [ ! -s "$tmp/sm.txt" ]; then
    rm -rf "$tmp"
    echo "Could not read any URLs from https://$HOST/sitemap.xml (a 503 there means the worker has no key index: run $0 --sync-keys)." >&2
    exit 1
  fi
  : > "$tmp/base.txt"
  if [ "${NT_NO_BASE:-0}" != "1" ]; then
    for p in "${BASE_PAGES[@]}"; do echo "https://$HOST/$p" >> "$tmp/base.txt"; done
  fi
  cat "$tmp/base.txt" "$tmp/sm.txt" | awk 'NF && !seen[$0]++' > "$tmp/urls.txt"
  # <KV key name><TAB><request URL>
  paste -d'\t' <(sitemap_kvform < "$tmp/urls.txt" | sed 's#^#render:#') "$tmp/urls.txt" > "$tmp/pairs.txt"
  read_epochs
  kvjson=$(kv_list_json "render:https://$HOST/") || { rm -rf "$tmp"; exit 1; }
  printf '%s\n' "$kvjson" \
    | jq -r --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name' | sort -u > "$tmp/cached.txt"
  : > "$out"; : > "$tab"
  awk -F'\t' -v miss="$out" -v tab="$tab" '
    NR == FNR { c[$0] = 1; next }
    {
      u = $2; sub(/^https?:\/\/[^\/]+/, "", u); n = split(u, a, "?")
      if (n < 2) t = "base pages (no args)"
      else {
        t = a[1]
        if (t == "/tour_guide.html" && a[2] ~ /tour=R-/) t = t " (repertoire)"
      }
      if ($1 in c) print t "\thit" >> tab
      else { print t "\tmiss" >> tab; print $2 >> miss }
    }' "$tmp/cached.txt" "$tmp/pairs.txt"
  SM_TOTAL=$(grep -c . "$tmp/urls.txt")
  SM_MISSING=$(grep -c . "$out")
  rm -rf "$tmp"
}

# The hits / misses table (stdout), from the table file written by sitemap_gap.
sitemap_table() {
  local tab="$1"
  printf '%-34s %8s %6s %6s %5s\n' "page type" "in list" "hit" "miss" "hit%"
  awk -F'\t' '{ t[$1]++; if ($2 == "hit") h[$1]++; else m[$1]++ }
    END { for (k in t) printf "%s\t%d\t%d\t%d\n", k, t[k], h[k] + 0, m[k] + 0 }' "$tab" \
    | sort -t$'\t' -k1,1 \
    | awk -F'\t' '{ printf "%-34s %8d %6d %6d %4d%%\n", $1, $2, $3, $4, ($2 ? int($3 * 100 / $2 + 0.5) : 0) }'
  awk -F'\t' '{ n++; if ($2 == "hit") h++ }
    END { printf "%-34s %8d %6d %6d %4d%%\n", "TOTAL", n, h + 0, n - h, (n ? int(h * 100 / n + 0.5) : 0) }' "$tab"
}

# --list-missing / --count-missing: report only, nothing is rendered.
#   list_missing <0|1>   (1 = table only, don't print the URLs)
list_missing() {
  local counts_only="${1:-0}" tmp tab
  tmp=$(mktemp "${TMPDIR:-/tmp}/updatecache-missing.XXXXXX")
  tab=$(mktemp "${TMPDIR:-/tmp}/updatecache-table.XXXXXX")
  sitemap_gap "$tmp" "$tab"
  [ "$counts_only" = "1" ] || cat "$tmp"
  if [ "$counts_only" = "1" ]; then sitemap_table "$tab"; else sitemap_table "$tab" >&2; fi
  if [ "$SM_MISSING" -gt 0 ]; then
    echo "Render some with: $0 --fill-missing N" >&2
  else
    echo "Every listed page has a snapshot." >&2
  fi
  rm -f "$tmp" "$tab"
  exit 0
}

# --fill-missing [N]: force-render N pages with no snapshot, NT_DELAY seconds apart. Missing base pages
# come first (all pages link from them), then random missing sitemap URLs.
fill_missing() {
  local tmp tab picks url i=0
  tmp=$(mktemp "${TMPDIR:-/tmp}/updatecache-missing.XXXXXX")
  tab=$(mktemp "${TMPDIR:-/tmp}/updatecache-table.XXXXXX")
  sitemap_gap "$tmp" "$tab"
  if [ "$SM_MISSING" -eq 0 ]; then
    echo "All $SM_TOTAL listed pages already have snapshots."
    rm -f "$tmp" "$tab"; exit 0
  fi
  # Missing pages whose last render the gatekeeper logged as NOT healthy come right after the base pages
  # (the same priority --performer/--venue/... give them), then the rest in random order.
  local hfile bad_urls="" other_urls nbad=0
  hfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-health.XXXXXX")
  unhealthy_pages_json | jq -r 'keys[]' > "$hfile" 2>/dev/null
  other_urls=$(grep '?' "$tmp")
  if [ -s "$hfile" ]; then
    # compare the page path+query (no host, no leading slash, + as %20) with the log's page strings
    bad_urls=$(printf '%s\n' "$other_urls" | awk 'NR == FNR { h[$0] = 1; next }
      { k = $0; sub(/^https?:\/\/[^\/]+\/?/, "", k); gsub(/\+/, "%20", k); if (k in h) print $0 }' "$hfile" -)
    if [ -n "$bad_urls" ]; then
      nbad=$(printf '%s\n' "$bad_urls" | grep -c .)
      other_urls=$(printf '%s\n' "$other_urls" | grep -v -x -F -f <(printf '%s\n' "$bad_urls") || true)
    fi
  fi
  rm -f "$hfile"
  echo "$SM_MISSING of $SM_TOTAL listed pages have no snapshot; rendering up to $COUNT (base pages first, then $nbad with a not-ok health log, then random; one every ${DELAY}s)."
  picks=$({ grep -v '?' "$tmp" | shuf
            [ -n "$bad_urls" ] && printf '%s\n' "$bad_urls" | shuf
            [ -n "$other_urls" ] && printf '%s\n' "$other_urls" | shuf; } | head -n "$COUNT")
  rm -f "$tmp" "$tab"
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    [ $i -gt 0 ] && sleep "$DELAY"
    i=$((i + 1))
    render_one "$url" "$i" || break
  done <<< "$picks"
  exit 0
}

# Optional count after --performer / --venue / --storyclub: how many pages to
# render in one run (default 1). Seconds between renders: NT_DELAY (default 12).
COUNT=1
KEYS_GIVEN=()
# --indexnow (anywhere after the type option) is a flag, not a key: with explicit keys it makes
# the run a content update (see update_finish). --delta / --refresh-stale read "$@" themselves.
INDEXNOW=0
TYPE_ARGS=()
for a in "${@:2}"; do
  if [ "$a" = "--indexnow" ]; then INDEXNOW=1; else TYPE_ARGS+=("$a"); fi
done
if [[ "${TYPE_ARGS[0]:-}" =~ ^[0-9]+$ ]]; then
  [ "${TYPE_ARGS[0]}" -ge 1 ] && COUNT="${TYPE_ARGS[0]}"
elif [ ${#TYPE_ARGS[@]} -gt 0 ]; then
  KEYS_GIVEN=("${TYPE_ARGS[@]}")   # anything non-numeric after the type option = explicit key(s)
fi
DELAY="${NT_DELAY:-12}"

# Page types: fill_one <page> <url param> <default jq filter> <jq override env var>
# NOTE: booksmerch assumes performers carry "books" / "merch" fields in the JSON;
# only performers with at least one of them are listed. Override with
# NT_KEYS_JQ_BOOKSMERCH if your field names differ.
dispatch() {
  case "$1" in
    performer)  fill_one performers performer "$JQ_PERFORMER" NT_KEYS_JQ_PERFORMER ;;
    venue)      fill_one venues venue "$JQ_VENUE" NT_KEYS_JQ_VENUE ;;
    storyclub)  fill_one storyclub club "$JQ_STORYCLUB" NT_KEYS_JQ_STORYCLUB ;;
    festival)   fill_one festival festival "$JQ_FESTIVAL" NT_KEYS_JQ_FESTIVAL ;;
    promoter)   fill_one promoters promoter "$JQ_PROMOTER" NT_KEYS_JQ_PROMOTER ;;
    booksmerch) fill_one books_merch performer "$JQ_BOOKSMERCH" NT_KEYS_JQ_BOOKSMERCH ;;
    repertoire) fill_one tour_guide performer "$JQ_REPERTOIRE" NT_KEYS_JQ_REPERTOIRE 1 "&tour=R-" ;;
    event)      fill_one event event "$JQ_EVENT" NT_KEYS_JQ_EVENT 0 "" 1 ;;
  esac
}

# ── --list-new / --delta ───────────────────────────────────────────────────
# Delta against what the worker already knows: the OLD key index (meta:keys in KV) is read
# BEFORE it is replaced, and every key in the new events JSON that wasn't in it is a new page.
#   performers, venues, promoters, festivals, story clubs and repertoire shows come from
#   meta:keys; pages of the performers/venues/clubs/promoters of any NEW event are re-rendered too (and so IndexNow'd);
#   events aren't in that index, so their ids are kept in a second KV key,
#   meta:delta-events (written by --delta; seeded on the first run, no events are "new" then).
# Plain (non-repertoire) tour pages have no known URL pattern here and are not rendered.
# New pages are remembered in a pending file (NT_PENDING_FILE, default ~/.updatecache-pending)
# until they have rendered successfully, so a quota stop or failed render never loses them.
#   delta_cmd <list|run> [N] [--indexnow]
kv_get_json() {   # <kv-key> <object|array>: print the stored JSON value, retrying like kv_list_json
  local key="$1" want="$2" attempt out
  for attempt in 1 2 3; do
    out=$(run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get "$key" \
            --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null | awk '/^[\[{]/ { s = 1 } s { print }')
    if printf '%s' "$out" | jq -e --arg w "$want" 'type == $w' >/dev/null 2>&1; then
      printf '%s\n' "$out"; return 0
    fi
    [ $attempt -lt 3 ] && sleep 3
  done
  return 1
}

delta_cmd() {
  local mode="$1"; shift
  local limit=0 do_idx=0 a
  for a in "$@"; do
    case "$a" in
      --indexnow) do_idx=1 ;;
      ''|*[!0-9]*) echo "Unknown argument '$a' (usage: --delta [N] [--indexnow] | --list-new)" >&2; exit 1 ;;
      *) limit="$a" ;;
    esac
  done
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local pending="${NT_PENDING_FILE:-$HOME/.updatecache-pending}"
  DT=$(mktemp -d "${TMPDIR:-/tmp}/updatecache-delta.XXXXXX")
  trap 'autoresolve_flush; rm -rf "$DT"' EXIT
  local dt="$DT"

  note "Fetching the new events JSON..."
  load_events_and_index "$dt/events.json" || { echo "Could not fetch/parse the events JSON (set NT_EVENTS_JSON?)" >&2; exit 1; }
  printf '%s\n' "$NEW_INDEX" > "$dt/new.json"

  note "Reading the worker's current key index (the baseline)..."
  if ! kv_get_json meta:keys object > "$dt/old.json"; then
    if [ "${NT_DELTA_ALL:-0}" = "1" ]; then
      echo '{}' > "$dt/old.json"
    else
      echo "Could not read meta:keys from KV, so there is no baseline to diff against." >&2
      echo "Check 'npx wrangler whoami'. NT_DELTA_ALL=1 treats EVERY page as new." >&2
      exit 1
    fi
  fi

  # New keys per type, as full URLs
  jq -nr --arg h "https://$HOST" --slurpfile o "$dt/old.json" --slurpfile n "$dt/new.json" '
    ($o[0]) as $o | ($n[0]) as $n
    | def d(t): (($n[t] // []) - ($o[t] // []))[];
      (d("performers") | "\($h)/performers.html?performer=\(@uri)"),
      (d("venues")     | "\($h)/venues.html?venue=\(@uri)"),
      (d("promoters")  | "\($h)/promoters.html?promoter=\(@uri)"),
      (d("festivals")  | "\($h)/festival.html?festival=\(@uri)"),
      (d("clubs")      | "\($h)/storyclub.html?club=\(@uri)")
  ' > "$dt/urls.txt"

  # New repertoire shows (R-<show>): need the performer, found the same way as --list-repertoire
  local newR tails
  newR=$(jq -nc --slurpfile o "$dt/old.json" --slurpfile n "$dt/new.json" '
    ($o[0]) as $o | ($n[0]) as $n
    | [(($n.tours // []) - ($o.tours // []))[] | select(startswith("R-"))]')
  if [ "$newR" != "[]" ]; then
    printf '%s' "$newR" | jq -r '.[] | "&tour=" + @uri' > "$dt/sufs.txt"
    tails=$(jq -r "${NT_KEYS_JQ_REPERTOIRE:-$JQ_REPERTOIRE}" "$dt/events.json" 2>/dev/null)
    # suffix list goes in via a file (BSD/macOS awk rejects newlines in -v values)
    printf '%s\n' "$tails" | awk '
      NR == FNR { if ($0 != "") w[$0] = 1; next }
      { for (s in w) if (length($0) >= length(s) && substr($0, length($0) - length(s) + 1) == s) { print; next } }' \
      "$dt/sufs.txt" - \
      | sed "s#^#https://$HOST/tour_guide.html?performer=#" >> "$dt/urls.txt"
  fi
  local skipped_tours
  skipped_tours=$(jq -nr --slurpfile o "$dt/old.json" --slurpfile n "$dt/new.json" '
    ($o[0]) as $o | ($n[0]) as $n
    | [(($n.tours // []) - ($o.tours // []))[] | select((startswith("R-") or startswith("rep:")) | not)] | length')

  # New events: baseline is the id list stored in KV by the previous --delta run
  jq -c "[ ${NT_KEYS_JQ_EVENT:-$JQ_EVENT} ]" "$dt/events.json" > "$dt/ev_new.json" 2>/dev/null || echo '[]' > "$dt/ev_new.json"
  : > "$dt/rel_urls.txt"
  local ev_note="" ev_seeded=1
  if kv_get_json meta:delta-events array > "$dt/ev_old.json"; then
    ev_seeded=0
    local ids up rest
    ids=$(jq -nr --slurpfile o "$dt/ev_old.json" --slurpfile n "$dt/ev_new.json" '(($n[0]) - ($o[0]))[]')
    if [ -n "$ids" ]; then
      # Performer and venue pages of each NEW event list that event, so they are refreshed too.
      # Follows the schema: performer_id / performer_ids / support_performer_ids / other_performer_ids
      # and venue_id are read from the event AND its parents (tours[k], repertoire_shows[k]); a blank
      # venue falls back to the club's venue_id when inheritClubData is true. The event's club (club /
      # club_event) and promoter (promoter_id / legacy promoter) pages are included too, and a club that
      # is also a promoter (isPromoter, or a promoters entry with the same key) pings its promoter page.
      # Unknown keys are dropped.
      # Override with NT_KEYS_JQ_EVENT_LINKS: a jq filter run on the events JSON that gets $ids
      # (array of new event ids) and $h (https://host) and prints full page URLs.
      local links_jq
      if [ -n "${NT_KEYS_JQ_EVENT_LINKS:-}" ]; then
        links_jq="$NT_KEYS_JQ_EVENT_LINKS"
      else
        # (read -d '' rather than a heredoc inside $(...): bash 3.2 on macOS chokes on that)
        read -r -d '' links_jq <<'JQEND'
def perfs: [ (.performer_id? | strings),
             ((.performer_ids?, .support_performer_ids?, .other_performer_ids?) | arrays | .[] | strings) ];
. as $root
| (.performers | keys | map({(.): true}) | add // {}) as $pks
| (.venues | keys | map({(.): true}) | add // {}) as $vks
| ($ids[0] | map({(.): true}) | add // {}) as $set
| ((.clubs // []) | map(select((.club // "") != "") | {(.club): (.venue_id // "")}) | add // {}) as $clubv
| ((.clubs // []) | map(select((.club // "") != "") | {(.club): true}) | add // {}) as $clubs
| (((.promoters // {}) | keys | map({(.): true}) | add // {})
   + ((.clubs // []) | map(select(.isPromoter == true and (.club // "") != "") | {(.club): true}) | add // {})) as $prom
| [ paths(type == "object" and ((.eventId // null) | type) == "string") as $p
    | getpath($p) as $e
    | select($set[$e.eventId] == true)
    | ([range(0; ($p | length) + 1) as $k | $root | getpath($p[0:$k])] | map(select(type == "object"))) as $chain
    | ([$chain[] | perfs[]] | unique | map(select($pks[.] == true))) as $pp
    | ([$chain[] | (.venue_id? | strings) | select(. != "")] | unique) as $v0
    | (if ($v0 | length) > 0 then $v0
       elif (($e.inheritClubData? // false) == true) then [ $clubv[($e.club? // $e.club_event? // "")] // empty | select(. != "") ]
       else [] end) as $vv
    | ([$chain[] | (.club?, .club_event?) | strings | select(. != "")] | unique | map(select($clubs[.] == true))) as $cc
    | (([$chain[] | (.promoter_id?, .promoter?) | strings | select(. != "")] + $cc) | unique | map(select($prom[.] == true))) as $pr
    | ($pp[] | "\($h)/performers.html?performer=\(@uri)"),
      ($vv[] | select($vks[.] == true) | "\($h)/venues.html?venue=\(@uri)"),
      ($cc[] | "\($h)/storyclub.html?club=\(@uri)"),
      ($pr[] | "\($h)/promoters.html?promoter=\(@uri)") ] as $first
# New TOUR / REPERTOIRE dates: their T-/R- ids are generated (no eventId field), so match them by
# regenerating the id. Pings the performer(s) of the tour/show (and of the date) and the date's venue.
| def gid($pre; $k): (.eventId? | select(type == "string" and . != "")) // ((.date | ymd) as $dd | "\($pre)\($k)-\($dd)-\(vid)");
  [ ( ((.tours // {}) | to_entries[] | {pre: "T-", k: .key, t: .value, ds: (.value.tour_dates // [])}),
      ((.repertoire_shows // {}) | to_entries[] | {pre: "R-", k: .key, t: .value, ds: (.value.show_dates // [])}) )
    | . as $g | $g.ds[] | . as $d
    | select($set[($d | gid($g.pre; $g.k))] == true)
    | ([$g.t, $d] | map(select(type == "object"))) as $chain
    | ([$chain[] | perfs[]] | unique | map(select($pks[.] == true))) as $pp
    | ([$d.venue_id? // empty | strings | select(. != "")]) as $vv
    | ($pp[] | "\($h)/performers.html?performer=\(@uri)"),
      ($vv[] | select($vks[.] == true) | "\($h)/venues.html?venue=\(@uri)") ] as $second
| ($first + $second) | unique | .[]
JQEND
        links_jq="$JQ_TOUR_DEFS"$'\n'"$links_jq"
      fi
      printf '%s\n' "$ids" | jq -Rn '[inputs]' > "$dt/newids.json"
      jq -r --arg h "https://$HOST" --slurpfile ids "$dt/newids.json" "$links_jq" "$dt/events.json" \
        > "$dt/rel_urls.txt" 2>/dev/null || : > "$dt/rel_urls.txt"
      [ -s "$dt/rel_urls.txt" ] || ev_note="New events found, but no performer/venue keys could be matched in the JSON (set NT_KEYS_JQ_EVENT_LINKS)."
    fi
    if [ -n "$ids" ]; then
      up=$(printf '%s\n' "$ids" | upcoming_dated | sort | cut -f2-)
      rest=$(comm -23 <(printf '%s\n' "$ids" | sort) <(printf '%s\n' "$up" | sort))
      { [ -n "$up" ] && printf '%s\n' "$up"; [ -n "$rest" ] && printf '%s\n' "$rest"; } \
        | jq -Rr --arg h "https://$HOST" '"\($h)/event.html?event=\(@uri)"' > "$dt/ev_urls.txt"
    else
      : > "$dt/ev_urls.txt"
    fi
  else
    : > "$dt/ev_urls.txt"
    ev_note="No event baseline in KV yet (meta:delta-events): events are not diffed this run; use --event N for them. It is seeded by --delta."
  fi

  # pending (earlier failures / quota leftovers) first, then new pages, then new events
  { [ -s "$pending" ] && cat "$pending"; cat "$dt/urls.txt" "$dt/rel_urls.txt" "$dt/ev_urls.txt"; } \
    | awk 'NF && !seen[$0]++' > "$dt/all.txt"
  local n_pending=0 n_new total
  [ -s "$pending" ] && n_pending=$(grep -c . "$pending")
  n_new=$(( $(grep -c . "$dt/urls.txt") + $(grep -c . "$dt/ev_urls.txt") ))
  total=$(grep -c . "$dt/all.txt")

  local n_rel
  n_rel=$(grep -c . "$dt/rel_urls.txt")
  echo "$n_new new page(s) vs the worker's index, $n_pending still pending from earlier; $total to render." >&2
  [ "$n_rel" -gt 0 ] && echo "($n_rel performer/venue/club/promoter page(s) are included because new events were added to them.)" >&2
  [ "${skipped_tours:-0}" -gt 0 ] && echo "($skipped_tours new plain tour key(s) not rendered: no URL pattern known here.)" >&2
  [ -n "$ev_note" ] && echo "$ev_note" >&2

  if [ "$mode" = "list" ]; then
    cat "$dt/all.txt"
    echo "(list only: nothing was changed. ./updatecache --delta renders them and updates the index.)" >&2
    exit 0
  fi

  # 1. remember the work BEFORE the baseline moves, so nothing is lost if we stop early
  cp "$dt/all.txt" "$pending"
  # 2. replace the worker's index (same call as --sync-keys)
  local code
  code=$(curl -s -o /dev/null -w "%{http_code}" -X POST -H "x-sync-keys: $SECRET" \
           --data-binary @"$dt/new.json" "https://$HOST/")
  case "$code" in
    2??) echo "Key index synced [HTTP $code]." ;;
    *) echo "Key index sync FAILED [HTTP $code]; nothing rendered. Pending list kept in $pending." >&2; exit 1 ;;
  esac
  # 3. move the event baseline
  if ! run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key put meta:delta-events \
         --path "$dt/ev_new.json" --namespace-id "$NT_KV_NAMESPACE_ID" --remote >/dev/null 2>&1; then
    echo "Warning: could not store meta:delta-events; the next --delta may list the same events again." >&2
  elif [ $ev_seeded -eq 1 ]; then
    echo "Event baseline seeded ($(jq length "$dt/ev_new.json") ids)."
  fi

  # 4. render, NT_DELAY apart, stop at the quota or after N
  : > "$dt/ok.txt"
  RENDERED_FILE="$dt/ok.txt"
  NT_MARK_UPDATED=1   # these renders follow a content update: stamp sitemap <lastmod> (see render_one)
  local i=0 url
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    [ "$limit" -gt 0 ] && [ $i -ge "$limit" ] && break
    [ $i -gt 0 ] && sleep "$DELAY"
    i=$((i + 1))
    render_one "$url" "$i" || break
  done < "$dt/all.txt"
  unset RENDERED_FILE NT_MARK_UPDATED

  # 5. what did not render stays pending
  grep -vxFf "$dt/ok.txt" "$dt/all.txt" > "$pending" || true
  local n_ok n_left
  n_ok=$(grep -c . "$dt/ok.txt"); n_left=$(grep -c . "$pending")
  echo "Rendered OK: $n_ok. Still pending: $n_left$( [ "$n_left" -gt 0 ] && echo " (in $pending; run ./updatecache --delta again, e.g. after the quota resets)")."

  # 6. rendered pages wait in an "unsubmitted" list until IndexNow has accepted them, so
  #    --indexnow can be run in this run OR a later one (a second --delta finds nothing new)
  local unsub="${NT_UNSUBMITTED_FILE:-$HOME/.updatecache-indexnow}"
  [ -s "$dt/ok.txt" ] && { cat "$dt/ok.txt" >> "$unsub"; awk 'NF && !seen[$0]++' "$unsub" > "$dt/unsub.tmp" && mv "$dt/unsub.tmp" "$unsub"; }
  local n_unsub=0
  [ -s "$unsub" ] && n_unsub=$(grep -c . "$unsub")
  if [ $do_idx -eq 1 ]; then
    if [ "$n_unsub" -gt 0 ]; then
      if bash "$(cd "$(dirname "$0")" && pwd)/indexnow.sh" -f "$unsub"; then
        : > "$unsub"
      else
        echo "IndexNow did not accept everything; the $n_unsub URL(s) stay in $unsub for the next --delta --indexnow." >&2
      fi
    else
      echo "Nothing waiting to be sent to IndexNow."
    fi
  elif [ "$n_unsub" -gt 0 ]; then
    echo "$n_unsub rendered URL(s) waiting for IndexNow (in $unsub). Send them any time with: ./updatecache --delta --indexnow"
  fi
  exit 0
}

# ── added commands: --list-expiring, --list-retry, --list-orphans / --purge-orphans, --quota, --daily ──

# Sets PAT / XPAT (grep -E patterns on a page URL) for a type word; returns 1 for an unknown type.
# (the same words and patterns --refresh-stale uses; "" = every page)
type_pattern() {
  PAT=""; XPAT=""
  case "$1" in
    "")                       ;;
    performer|performers)     PAT='/performers\.html\?performer=' ;;
    venue|venues)             PAT='/venues\.html\?venue=' ;;
    storyclub|storyclubs)     PAT='/storyclub\.html\?club=' ;;
    festival|festivals)       PAT='/festival\.html\?festival=' ;;
    promoter|promoters)       PAT='/promoters\.html\?promoter=' ;;
    booksmerch)               PAT='/books_merch\.html\?' ;;
    repertoire|repertoires)   PAT='/tour_guide\.html\?(.*&)?tour=(R-|rep%3A)' ;;
    tour|tours)               PAT='/tour_guide\.html\?(.*&)?tour='; XPAT='tour=(R-|rep%3A)' ;;
    media)                    PAT='/media\.html' ;;
    event|events)             PAT='/event\.html\?event=' ;;
    *) return 1 ;;
  esac
}

# --list-expiring [HOURS] [type] [--all]: snapshots whose KV expiry falls within HOURS (default
# NT_EXPIRY_WARN_HOURS = 120), soonest first, as full URLs. A snapshot only expires 90 days after its
# last write, so these are the pages about to drop out of the cache: re-render them with
#   ./updatecache $(./updatecache --list-expiring 120 20)      (or just: ./updatecache $(./updatecache --list-expiring))
# Past events (event id dated more than 30 days ago, the same cut-off as the sitemap) are left out,
# because they are allowed to fade away; --all includes them.
list_expiring() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local hours="$EXPIRY_WARN_HOURS" type="" a allp=0 limit=999999 seen_num=0
  for a in "$@"; do
    if [[ "$a" =~ ^[0-9]+$ ]]; then
      if [ $seen_num -eq 0 ]; then [ "$a" -ge 1 ] && hours="$a"; seen_num=1; else [ "$a" -ge 1 ] && limit="$a"; fi
    elif [ "$a" = "--all" ]; then allp=1
    elif [ -n "$a" ]; then type="$a"; fi
  done
  type_pattern "$type" || { echo "Unknown type '$type' (performer venue storyclub festival promoter booksmerch repertoire tour media event)" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local now_ms=$(( $(date +%s) * 1000 )) soon_ms=$(( hours * 3600000 )) json all total nall
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  local base="render:https://$HOST"
  all=$(printf '%s\n' "$json" | jq -r --arg base "$base" --argjson now "$now_ms" --argjson soon "$soon_ms" --argjson allp "$allp" '
      def evdate: ((capture("(^|-)(?<d>20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01]))(-|$)").d)
                   // (capture("-(?<ms>[0-9]{12,14})$").ms | tonumber / 1000 | floor | strftime("%Y%m%d")));
      (now - 2592000 | strftime("%Y%m%d")) as $cut
      | [ .[] | select(.name | startswith($base))
              | select(.expiration != null and (.expiration * 1000 - $now) < $soon)
              | ([ .name | capture("/event\\.html\\?event=(?<e>[^&]*)") | .e ] | first // null) as $e
              | ((if $e == null then null else (try ($e | evdate) catch null) end) // null) as $d
              | select($allp == 1 or $d == null or $d >= $cut)
              | { name: .name, exp: .expiration } ]
      | sort_by(.exp) | .[] | .name | ltrimstr("render:")')
  total=$(printf '%s\n' "$json" | jq -r --arg base "$base" --argjson now "$now_ms" --argjson soon "$soon_ms" \
      '[ .[] | select(.name | startswith($base)) | select(.expiration != null and (.expiration * 1000 - $now) < $soon) ] | length')
  if [ -n "$PAT" ]; then all=$(printf '%s\n' "$all" | grep -E -- "$PAT"); fi
  if [ -n "$XPAT" ]; then all=$(printf '%s\n' "$all" | grep -v -E -- "$XPAT"); fi
  nall=$(printf '%s\n' "$all" | grep -c .)
  if [ "$nall" -eq 0 ]; then
    echo "No ${type:-page} snapshots expire within ${hours}h (of $total expiring in all).$([ $allp -eq 0 ] && [ "$total" -gt 0 ] && echo " Past events are left out; add --all to include them.")" >&2
    exit 0
  fi
  echo "$nall ${type:-page} snapshot(s) expire within ${hours}h, soonest first ($total expiring in all; past events $([ $allp -eq 1 ] && echo included || echo left out))." >&2
  printf '%s\n' "$all" | head -n "$limit"
  exit 0
}

# --list-retry: pages whose latest render was NOT healthy, so the gatekeeper kept the old snapshot and
# flagged it for retry (KV metadata retry/fails). Shows failures so far, age of the kept page, the
# health status and reason from the health log, and the URL. Pages at the retry cap (NT_MAX_RETRIES,
# default 3 = the gatekeeper's MAX_UNHEALTHY_RETRIES) are no longer retried first: they are the ones
# that need a data/code fix. One listing of render: and one of health:, no renders.
list_retry() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local now_ms=$(( $(date +%s) * 1000 )) cap="${NT_MAX_RETRIES:-3}" json hfile rows
  json=$(kv_list_json "render:https://$HOST/") || exit 1
  hfile=$(mktemp "${TMPDIR:-/tmp}/updatecache-hl.XXXXXX")
  kv_list_json "health:" > "$hfile" 2>/dev/null || echo '[]' > "$hfile"
  rows=$(printf '%s\n' "$json" | jq -r --slurpfile h "$hfile" --arg base "render:https://$HOST" \
      --argjson now "$now_ms" --argjson cap "$cap" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    ($h[0] | map(select((.metadata.status // "") != "" and (.metadata.status // "") != "ok")
                 | { p: ((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm),
                     s: .metadata.status, r: (.metadata.reason // ""), at: (.metadata.at // "") })
             | sort_by(.at) | reduce .[] as $e ({}; .[$e.p] = $e)) as $hm
    | [ .[] | select(.name | startswith($base)) | select((.metadata.retry // 0) == 1)
            | (.name | ltrimstr($base + "/") | gsub("\\+"; "%20")) as $pg
            | { url: (.name | ltrimstr("render:")), fails: (.metadata.fails // 0), ts: (.metadata.ts // 0),
                s: ($hm[$pg].s // "?"), r: ($hm[$pg].r // "") } ]
    | sort_by(-.fails, .ts) | .[]
    | [ .fails, (if .ts > 0 then ((((($now - .ts) / 86400000) * 10 | floor) / 10 | tostring) + "d") else "?" end),
        (if .fails >= $cap then "capped" else "retrying" end), .s, .url, .r ] | @tsv')
  rm -f "$hfile"
  if [ -z "$rows" ]; then
    echo "No snapshot is flagged for retry: every stored page came from a healthy render."
    exit 0
  fi
  printf '%s\n' "$rows" | awk -F'\t' '
    BEGIN { printf "%5s %7s %-9s %-8s %s\n", "fails", "age", "state", "health", "page  --  reason" }
    { printf "%5d %7s %-9s %-8s %s%s\n", $1, $2, $3, $4, $5, ($6 != "" ? "  --  " $6 : ""); n++; if ($3 == "capped") c++ }
    END { printf "\n%d page(s) are serving an OLD snapshot because the latest render was not healthy; %d at the retry cap.\n", n, c + 0
          print "Capped pages are not retried first any more: fix the data/page, then re-render (./updatecache --repair, or the page by name)." }'
  exit 0
}

# Prints, for one page type, the snapshots whose key is no longer in the events JSON (the "orphans"
# column of --status), as request-ready URLs. Uses the globals set by orphans_collect.
#   orphan_row <label> <page> <param> <default-jq> <jq-env-override> [rawmode] [tag]
orphan_row() {
  local label="$1" page="$2" param="$3" default_jq="$4" jq_override="$5"
  local rawmode="${6:-0}" tag="${7:-}" uri_filter="| @uri"; [ "$rawmode" = "1" ] && uri_filter=""
  [ -z "$ORPH_TYPE" ] || [ "$ORPH_TYPE" = "$label" ] || return 0
  local jq_keys="${!jq_override:-$default_jq}" prefix="render:https://$HOST/$page.html?$param=" all cached k
  all=$(echo "$STATUS_JSON" | jq -r "$jq_keys $uri_filter" 2>/dev/null \
    | sed -e 's/%20/+/g' -e 's/~/%7E/g' -e 's/%2A/*/g' | sort -u)
  cached=$(echo "$STATUS_NAMES" \
    | awk -v p="$prefix" 'index($0, p) == 1 { print substr($0, length(p) + 1) }' \
    | { if [ -n "$tag" ]; then grep -F -- "$tag"; else cat; fi; } | sort -u)
  [ -n "$all" ] || return 0     # no keys read for this type: never call everything an orphan
  comm -13 <(echo "$all") <(echo "$cached") | grep . | while IFS= read -r k; do
    printf 'https://%s/%s.html?%s=%s\n' "$HOST" "$page" "$param" "${k//+/%20}"
  done
}

# Fetch the events JSON + the KV listing (as --status does) and fill ORPHANS with every orphan URL.
orphans_collect() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local type="$1" name json_url statusjson
  case "$type" in
    "") ORPH_TYPE="" ;;
    performer|performers) ORPH_TYPE=performers ;;
    venue|venues) ORPH_TYPE=venues ;;
    storyclub|storyclubs) ORPH_TYPE=storyclubs ;;
    festival|festivals) ORPH_TYPE=festivals ;;
    promoter|promoters) ORPH_TYPE=promoters ;;
    booksmerch) ORPH_TYPE=booksmerch ;;
    repertoire|repertoires) ORPH_TYPE=repertoire ;;
    event|events) ORPH_TYPE=events ;;
    *) echo "Unknown type '$type' (performer venue storyclub festival promoter booksmerch repertoire event)" >&2; exit 1 ;;
  esac
  STATUS_JSON=""
  for name in events_normalized events_normalised; do
    json_url="${NT_EVENTS_JSON:-https://$HOST/$name.json}"
    STATUS_JSON=$(curl -sf --max-time 60 "$json_url") && [ -n "$STATUS_JSON" ] && break
    STATUS_JSON=""
  done
  [ -n "$STATUS_JSON" ] || { echo "Could not fetch the events JSON (set NT_EVENTS_JSON?); not listing anything." >&2; exit 1; }
  read_epochs
  statusjson=$(kv_list_json "render:https://$HOST/") || exit 1
  STATUS_NAMES=$(printf '%s\n' "$statusjson" \
    | jq -r --argjson hard "$EPOCH_HARD" --argjson ttl "$TTL_MS" \
        "$JQ_TS_DEF"'.[] | select((entry_ts // $hard) >= $hard) | .name')
  ORPHANS=$({
    orphan_row performers  performers  performer "$JQ_PERFORMER"  NT_KEYS_JQ_PERFORMER
    orphan_row venues      venues      venue     "$JQ_VENUE"      NT_KEYS_JQ_VENUE
    orphan_row storyclubs  storyclub   club      "$JQ_STORYCLUB"  NT_KEYS_JQ_STORYCLUB
    orphan_row festivals   festival    festival  "$JQ_FESTIVAL"   NT_KEYS_JQ_FESTIVAL
    orphan_row promoters   promoters   promoter  "$JQ_PROMOTER"   NT_KEYS_JQ_PROMOTER
    orphan_row booksmerch  books_merch performer "$JQ_BOOKSMERCH" NT_KEYS_JQ_BOOKSMERCH
    orphan_row repertoire  tour_guide  performer "$JQ_REPERTOIRE" NT_KEYS_JQ_REPERTOIRE 1 "&tour=R-"
    orphan_row events      event       event     "$JQ_EVENT"      NT_KEYS_JQ_EVENT
  })
}

# --list-orphans [type]: snapshots whose key is no longer in the events JSON (see the orphans column
# of --status), one URL per line. They are never requested again; they just expire after 90 days.
list_orphans() {
  orphans_collect "$1"
  if [ -z "$ORPHANS" ]; then echo "No orphan snapshots${1:+ for $1}." >&2; exit 0; fi
  printf '%s\n' "$ORPHANS"
  echo "$(printf '%s\n' "$ORPHANS" | grep -c .) orphan snapshot(s). Remove them with: $0 --purge-orphans${1:+ $1}" >&2
  exit 0
}

# --purge-orphans [type] [--yes]: delete the orphan snapshots (no render, no browser time).
purge_orphans() {
  local type="" yes=0 a n
  for a in "$@"; do if [ "$a" = "--yes" ]; then yes=1; elif [ -n "$a" ]; then type="$a"; fi; done
  orphans_collect "$type"
  if [ -z "$ORPHANS" ]; then echo "No orphan snapshots${type:+ for $type}."; exit 0; fi
  n=$(printf '%s\n' "$ORPHANS" | grep -c .)
  printf '%s\n' "$ORPHANS"
  echo
  echo "$n orphan snapshot(s) listed above: their keys are not in the events JSON, so nothing links to them."
  if [ $yes -ne 1 ]; then
    read -r -p "Type YES to delete them: " answer
    [ "$answer" = "YES" ] || { echo "Cancelled."; exit 1; }
  fi
  local urls=()
  while IFS= read -r a; do [ -n "$a" ] && urls+=("$a"); done <<< "$ORPHANS"
  exec bash "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" --purge-only "${urls[@]}"
}

# Read a numeric KV value (lock:quota, lock:strikes). Prints nothing if the key does not exist.
kv_get_number() {
  run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key get "$1" \
    --namespace-id "$NT_KV_NAMESPACE_ID" --remote 2>/dev/null | tr -d '\r' | grep -E '^[0-9]+$' | head -n 1
}

# --quota: is the gatekeeper holding renders back after Browser Run 429s? (lock:quota = pause end,
# lock:strikes = 429s today.) Exit status 3 when paused, so scripts can stop early. Free: two KV reads.
quota_cmd() {
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  local q s now_ms until mins
  q=$(kv_get_number lock:quota); s=$(kv_get_number lock:strikes)
  now_ms=$(( $(date +%s) * 1000 ))
  if [ -n "$q" ] && [ "$q" -le 1000000000000 ] 2>/dev/null; then   # legacy flag value: paused until UTC midnight
    q=$(( ($(date -u +%s) / 86400 + 1) * 86400 * 1000 ))
  fi
  echo "429s from Browser Run today: ${s:-0}"
  if [ -n "$q" ] && [ "$q" -gt "$now_ms" ] 2>/dev/null; then
    mins=$(( (q - now_ms) / 60000 ))
    echo "Renders are PAUSED until $(fmt_epoch "$q") (in ${mins} min)."
    if [ "$mins" -gt 480 ]; then echo "That is the daily quota: it resets at 00:00 UTC. $0 --force tries anyway."
    else echo "A short back-off after a 429; $0 waits it out, or --force tries anyway."; fi
    exit 3
  fi
  echo "No render pause recorded: renders should go through."
  exit 0
}

# --daily [N]: the whole daily routine in one go, within N renders (default NT_DAILY_RENDERS or 30):
#   1. does nothing if renders are paused (--force overrides)    2. shows the last day's unhealthy renders
#   3. --repair --skip-capped (about N/4)   4. --fill-missing (about N/4)
#   5. --refresh-stale --oldest --skip-bad --skip-capped (the rest; pages the first step already tried are not repeated)
# Each step stops cleanly on the daily quota, and so does the whole routine.
daily_cmd() {
  local n="${NT_DAILY_RENDERS:-30}" a fw=() log rc self remaining used step
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  for a in "$@"; do [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -ge 1 ] && n="$a"; done
  [ "$FORCE" = "1" ] && fw=(--force)
  echo "== Daily maintenance: a budget of $n renders, spent in this order: repair, then pages with no snapshot, then oldest stale, then (last) stale event pages dated >30 days ago =="
  if [ "$FORCE" != "1" ]; then
    bash "$self" --quota; rc=$?
    if [ $rc -eq 3 ]; then echo "Stopping: renders are paused. (add --force to try anyway)"; exit 0; fi
  fi
  echo; echo "-- unhealthy renders in the last day --"
  bash "$self" --health 1 2>&1 | head -n 25
  log=$(mktemp "${TMPDIR:-/tmp}/updatecache-daily.XXXXXX")
  remaining=$n
  # Each step may use ALL of what is left (renders spent so far are counted from its "[k] === url" lines);
  # whatever a step does not use falls through to the next one. Unhealthy pages are always repaired first
  # (old events too); only STALE old events are left out of step 3 (--no-old-events) and get what remains last.
  for step in "repair (every page in the health log, with or without a snapshot, plus retry-flagged ones; not the capped ones)|--repair @N@ --skip-capped" \
              "fill missing (no snapshot yet)|--fill-missing @N@" \
              "oldest stale|--refresh-stale @N@ --oldest --skip-bad --skip-capped --no-old-events" \
              "stale old events (dated more than 30 days ago), last|--refresh-stale @N@ --oldest --skip-bad --skip-capped --old-events-only"; do
    if [ "$remaining" -le 0 ]; then echo; echo "Render budget ($n) used up; skipping: ${step%%|*}."; continue; fi
    echo; echo "-- ${step%%|*} (up to $remaining of $n renders left) --"
    step="${step#*|}"
    # shellcheck disable=SC2086
    bash "$self" ${step//@N@/$remaining} ${fw[@]+"${fw[@]}"} 2>&1 | tee "$log"
    if grep -qiE 'quota exhausted|renders are paused' "$log"; then
      echo; echo "Browser quota reached: stopping here; run again after 00:00 UTC (or when the pause ends)."
      rm -f "$log"; exit 0
    fi
    used=$(grep -cE '^\[[0-9]+\] === ' "$log")
    remaining=$(( remaining - used ))
  done
  rm -f "$log"
  echo; echo "Done: $(( n - remaining )) of $n renders used. Check progress with: $0 --staleness   (pages stuck on an old snapshot: $0 --list-retry; about to expire: $0 --list-expiring)"
  exit 0
}

# --resolved <page>... | --all [--yes]: remove entries from the health log (the health:<day>:<page> keys
# that --health, --daily and the repair priority read). The log is append-only and entries live 7 days;
# a purge or a healthy re-render never removes them, so use this for pages that were fixed, or never
# were real pages (e.g. a mistyped /50). Pages are matched EXACTLY after normalising (scheme/host and
# leading slash dropped, "+" = %20): 50, /50, performers.html?performer=x or a full URL all work.
# It only touches the log, not snapshots (so a snapshot's own retry flag stays: re-render the page).
resolved_cmd() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  NT_KV_NAMESPACE_ID="${NT_KV_NAMESPACE_ID:-ed745137e08841a5825c67079f7c4c43}"
  local yes=0 all=0 a targets=() tjson json names n k answer failed=0 done_n=0
  for a in "$@"; do
    case "$a" in
      --yes) yes=1 ;;
      --all) all=1 ;;
      "") ;;
      *) targets+=("$a") ;;
    esac
  done
  if [ $all -eq 0 ] && [ ${#targets[@]} -eq 0 ]; then
    echo "Usage: $0 --resolved <page> [page...] [--yes]   |   $0 --resolved --all [--yes]" >&2
    exit 1
  fi
  if [ $all -eq 1 ] && [ ${#targets[@]} -gt 0 ]; then
    echo "Give either pages or --all, not both." >&2; exit 1
  fi
  tjson=$(if [ ${#targets[@]} -gt 0 ]; then printf '%s\n' "${targets[@]}" | jq -Rn '[inputs]'; else echo '[]'; fi)
  json=$(kv_list_json "health:") || exit 1
  names=$(printf '%s\n' "$json" | jq -r --argjson t "$tjson" --argjson all "$all" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    ($t | map(norm)) as $want
    | .[] | select($all == 1
                   or (((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm) as $p
                       | any($want[]; . == $p)))
    | .name')
  if [ -z "$names" ]; then
    if [ $all -eq 1 ]; then echo "The health log is already empty."; else echo "No health-log entries match: ${targets[*]}"; fi
    exit 0
  fi
  n=$(printf '%s\n' "$names" | grep -c .)
  printf '%s\n' "$json" | jq -r --argjson t "$tjson" --argjson all "$all" '
    def norm: sub("^https?://[^/]+/?"; "") | sub("^/"; "") | gsub("\\+"; "%20");
    ($t | map(norm)) as $want
    | .[] | select($all == 1
                   or (((.metadata.page // (.name | sub("^health:[0-9-]+:"; ""))) | tostring | norm) as $p
                       | any($want[]; . == $p)))
    | "  " + (.metadata.at // "?") + "  " + (.metadata.status // "?") + "  " + (.metadata.page // .name)'
  echo "$n health-log entr$([ "$n" -eq 1 ] && echo y || echo ies) listed above."
  if [ $yes -ne 1 ]; then
    read -r -p "Type YES to delete them from the log: " answer
    [ "$answer" = "YES" ] || { echo "Cancelled."; exit 1; }
  fi
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    if run_with_timeout "${NT_KV_TIMEOUT:-60}" npx wrangler kv key delete "$k" \
         --namespace-id "$NT_KV_NAMESPACE_ID" --remote >/dev/null 2>&1; then
      done_n=$((done_n + 1))
    else
      failed=$((failed + 1)); echo "Could not delete: $k" >&2
    fi
  done <<< "$names"
  echo "Deleted $done_n of $n log entr$([ "$n" -eq 1 ] && echo y || echo ies).$([ $failed -gt 0 ] && echo " $failed failed: run again, or check 'npx wrangler whoami'.")"
  [ $failed -eq 0 ] || exit 1
  exit 0
}

trap autoresolve_flush EXIT
case "$1" in
  --list-performers|--list-performer)  LIST_ONLY=1; dispatch performer ;;
  --list-venues|--list-venue)          LIST_ONLY=1; dispatch venue ;;
  --list-storyclubs|--list-storyclub)  LIST_ONLY=1; dispatch storyclub ;;
  --list-festivals|--list-festival)    LIST_ONLY=1; dispatch festival ;;
  --list-promoters|--list-promoter)    LIST_ONLY=1; dispatch promoter ;;
  --list-booksmerch)                   LIST_ONLY=1; dispatch booksmerch ;;
  --list-repertoire|--list-repertoires) LIST_ONLY=1; dispatch repertoire ;;
  --list-events|--list-event)          LIST_ONLY=1; dispatch event ;;
  --status)                            status_all ;;
  --list-missing)                      list_missing 0 ;;
  --count-missing)                     list_missing 1 ;;
  --fill-missing)                      fill_missing ;;
  --staleness)                         staleness_report ;;
  --inspect)                           inspect_cmd "${2:-}" "${3:-}" ;;
  --list-stale)                        list_stale "${@:2}" ;;
  --refresh-stale)                     refresh_stale "${@:2}" ;;
  --repair)                            refresh_stale --only-bad "${@:2}" ;;
  --list-recent)                       list_recent "${2:-}" ;;
  --list-cached)                       list_cached "${@:2}" ;;
  --health)                            health_report "${2:-}" ;;
  --list-expiring)                     list_expiring "${@:2}" ;;
  --list-retry)                        list_retry ;;
  --list-orphans)                      list_orphans "${2:-}" ;;
  --purge-orphans)                     purge_orphans "${@:2}" ;;
  --quota)                             quota_cmd ;;
  --daily)                             daily_cmd "${@:2}" ;;
  --resolved)                          resolved_cmd "${@:2}" ;;
  --performer|--performers)            dispatch performer ;;
  --venue|--venues)                    dispatch venue ;;
  --storyclub|--storyclubs)            dispatch storyclub ;;
  --festival|--festivals)              dispatch festival ;;
  --promoter|--promoters)              dispatch promoter ;;
  --booksmerch)                        dispatch booksmerch ;;
  --repertoire|--repertoires)          dispatch repertoire ;;
  --event|--events)                    dispatch event ;;
  --delta)                             delta_cmd run "${@:2}" ;;
  --list-new)                          delta_cmd list "${@:2}" ;;
  --stale|--purge|--purge-only)        ;;   # handled below
  --*) echo "Unknown option: $1 (see the usage notes at the top of this script)" >&2; exit 1 ;;
esac

STALE_ONLY=0
if [ "$1" = "--stale" ]; then STALE_ONLY=1; shift; fi

PURGE=0
PURGE_ONLY=0
case "$1" in
  --purge-only) PURGE=1; PURGE_ONLY=1; shift ;;
  --purge)      PURGE=1; shift ;;
esac

if [ $# -eq 0 ]; then
  echo "Usage: $0 [--list-<type>s | --<type> [N] | --count-missing | --list-missing | --fill-missing [N]]  (types: performer venue storyclub festival promoter booksmerch repertoire event) [--stale | --purge | --purge-only] <page-or-url> [...]  (or --soft-purge-all / --hard-purge-all / --refresh-stale [N] [type] [--oldest] [--indexnow] / --list-stale [N] [type] / --list-expiring / --list-retry / --list-orphans / --purge-orphans / --quota / --daily [N])" >&2
  exit 1
fi

first=1
for page in "$@"; do
  if [[ "$page" == http* ]]; then
    URL="$page"
  else
    page="${page#./}"; page="${page#/}"
    URL="https://$HOST/$page"
  fi

  if [ $STALE_ONLY -eq 1 ]; then
    echo "=== $URL"
    echo -n "Mark stale: "
    curl -s -w "  [HTTP %{http_code}]\n" -H "x-mark-stale: $SECRET" "$URL"
    continue
  fi

  # Free-plan Browser Run allows ~1 render per 10s, so space pages out.
  if [ $first -eq 0 ] && [ $PURGE_ONLY -eq 0 ]; then sleep 12; fi
  first=0

  echo "=== $URL"

  if [ $PURGE -eq 1 ]; then
    echo -n "Purge:   "
    curl -s -w "  [HTTP %{http_code}]\n" \
      -H "x-purge-cache: $SECRET" "$URL"
  fi

  [ $PURGE_ONLY -eq 1 ] && continue

  # Forced render can retry 3x with ~12s gaps, so allow a long timeout
  result=$(curl -s --max-time 120 -o /dev/null \
    -D - -w "" \
    -H "x-force-render: $SECRET" ${force_hdr[@]+"${force_hdr[@]}"} "$URL" \
    | grep -iE '^(HTTP/|x-prerendered|x-quota-exhausted|x-marked-stale|x-page-health)' | tr -d '\r' | paste -sd' ' -)
  echo "Refresh: $result"
  case "$result" in
    *x-quota-exhausted*) echo "Daily browser quota exhausted; stopping." >&2; break ;;
  esac
done
